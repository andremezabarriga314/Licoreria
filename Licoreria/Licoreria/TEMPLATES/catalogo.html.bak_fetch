                                    <label class="pay-tile pay-yape"><input type="radio" name="pago" value="Yape"><span><i class="fa-solid fa-mobile-screen-button"></i><b>Yape</b><small>Pago al instante</small></span></label>
                                    <label class="pay-tile pay-plin"><input type="radio" name="pago" value="Plin"><span><i class="fa-solid fa-mobile-screen-button"></i><b>Plin</b><small>Pago al instante</small></span></label>
                                    <label class="pay-tile pay-card"><input type="radio" name="pago" value="Tarjeta de débito"><span><i class="fa-solid fa-credit-card"></i><b>Tarjeta de débito</b><small>Con POS al recibir</small></span></label>
                                </div>
                                <div class="co-err" id="coPayErr">Elige una forma de pago.</div>
