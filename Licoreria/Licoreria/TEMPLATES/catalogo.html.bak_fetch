                                <div class="co-row co-total"><span>Total</span><b id="coTotal"></b></div>
                                <button type="submit" class="btn-gold w-100 mt-3" id="coSubmit">Confirmar pedido <i class="fa-solid fa-arrow-right ms-2"></i></button>
                                <p class="cart-muted text-center mt-3 mb-0"><i class="fa-solid fa-lock me-1"></i> Tus datos solo se usan para tu pedido.</p>
                            </div>
                        </div>
                    </div>
                </form>
