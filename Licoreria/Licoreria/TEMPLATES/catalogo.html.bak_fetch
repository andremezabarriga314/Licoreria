<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// AVISO DE ERRORES (solo en tu computadora, 127.0.0.1 / localhost): muestra un cuadro rojo con el error si algo falla
(function () {
    if (["127.0.0.1", "localhost"].indexOf(location.hostname) === -1) return;
    function show(msg) {
        let b = document.getElementById("devError");
        if (!b) {
            b = document.createElement("div");
            b.id = "devError";
            b.style.cssText = "position:fixed;left:12px;bottom:12px;z-index:99999;max-width:min(92vw,520px);background:#7a0f1f;color:#fff;padding:12px 16px;border-radius:6px;font:13px/1.5 monospace;box-shadow:0 8px 30px rgba(0,0,0,.6)";
            document.body.appendChild(b);
        }
        b.textContent = "Error en la página: " + msg;
    }
    window.addEventListener("error", function (e) {
        if (e.target === window) show(e.message + (e.lineno ? " (línea " + e.lineno + ")" : ""));
    });
    window.addEventListener("unhandledrejection", function (e) { show(String(e.reason)); });
})();
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    // CONTROL DE MAYORÍA DE EDAD
    const ageGate = document.getElementById("ageGate");
    const ageCard = document.getElementById("ageCard");
    const confirmAge = document.getElementById("confirmAge");
    const rejectAge = document.getElementById("rejectAge");
    const KEY = "libido_age_verified";

    // al recargar la página (F5), la verificación se pide de nuevo
    const nav = performance.getEntriesByType ? performance.getEntriesByType("navigation")[0] : null;
    if ((nav && nav.type === "reload") || (!nav && performance.navigation && performance.navigation.type === 1)) {
        sessionStorage.removeItem(KEY);
    }

    if (sessionStorage.getItem(KEY) === "true") {
        ageGate.classList.add("hidden");
    } else {
        document.body.classList.add("gate-open");
    }

    confirmAge.addEventListener("click", function () {
        sessionStorage.setItem(KEY, "true");
        ageGate.classList.add("leaving");
        setTimeout(function () {
            ageGate.classList.add("hidden");
            ageGate.classList.remove("leaving");
            document.body.classList.remove("gate-open");
            window.scrollTo(0, 0);
        }, 950);
    });

    rejectAge.addEventListener("click", function () {
        ageCard.innerHTML = `
            <img class="age-logo" src="${ageCard.querySelector(".age-logo") ? ageCard.querySelector(".age-logo").src : ""}" alt="">
            <div class="age-name">LIBIDO Y TENTACIÓN</div>
            <div class="age-line"></div>
            <h2>Acceso restringido</h2>
            <p>Debes ser mayor de 18 años para acceder al contenido de este sitio.</p>
        `;
    });

});
</script>


<script>
// HERO: la tira corre a velocidad constante (70 px/s) y los videos solo se reproducen si están a la vista
document.addEventListener("DOMContentLoaded", function () {
    const track = document.querySelector(".hero-track");
    if (!track) return;

    const SPEED = 70;

    function setSpeed() {
        const w = track.scrollWidth / 2;
        if (w > 0) track.style.animationDuration = (w / SPEED) + "s";
    }

    track.querySelectorAll("img").forEach(function (i) { i.addEventListener("load", setSpeed); });
    track.querySelectorAll("video").forEach(function (v) { v.addEventListener("loadedmetadata", setSpeed); });
    window.addEventListener("load", setSpeed);
    window.addEventListener("resize", setSpeed);
    setSpeed();

    if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { const p = e.target.play(); if (p && p.catch) p.catch(function () {}); }
                else e.target.pause();
            });
        });
        track.querySelectorAll("video").forEach(function (v) { io.observe(v); });
    }
});
</script>


