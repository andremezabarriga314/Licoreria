{% load static %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f1217">
    <meta name="description" content="Libido y Tentación: selección premium de licores y bebidas.">
    <title>Libido y Tentación | licorería</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --bg: #0f1217;
            --bg-soft: #14171d;
            --panel: #171a21;
            --panel-light: #1f232b;
            --gold: #d4bb8a;
            --gold-light: #e8d5ae;
            --cream: #efe8dd;
            --muted: #9da2ad;
            --wine: #8a1c4c;
            --wine-light: #b02a68;
            --border: rgba(212,187,138,.19);
        }

        * { box-sizing: border-box; }

        [hidden] { display: none !important; }

        html { scroll-behavior: smooth; scroll-padding-top: 100px; }

        body {
            margin: 0;
            background: radial-gradient(ellipse at 88% -8%, rgba(92,102,124,.16), transparent 55%), var(--bg);
            background-attachment: fixed;
            color: var(--cream);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
        }

        body.modal-open { overflow: hidden; }

        a { color: inherit; text-decoration: none; }

        button, input, select { font-family: inherit; }

        .serif { font-family: 'Playfair Display', serif; }

        .gold { color: var(--gold); }

        .section-label {
            color: var(--gold);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 4vw, 3.3rem);
            font-weight: 600;
            line-height: 1.15;
        }

        .topbar {
            background: #0a0c10;
            color: var(--muted);
            border-bottom: 1px solid rgba(212,187,138,.12);
            font-size: .72rem;
            letter-spacing: 1px;
            padding: 9px 0;
            text-align: center;
        }

        .navbar {
            background: rgba(15,18,23,.96);
            border-bottom: 1px solid var(--border);
            padding: 17px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(15px);
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.55rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--cream);
        }

        .brand span { color: var(--gold); }

        .brand-subtitle {
            display: block;
            font-family: 'DM Sans', sans-serif;
            color: var(--muted);
            font-size: .55rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: -3px;
        }

        .nav-link-custom {
            color: #d9d4c8;
            font-size: .85rem;
            margin: 0 12px;
            transition: .25s;
        }

        .nav-link-custom:hover { color: var(--gold); }

        .cart-button {
            background: var(--wine);
            border: 1px solid rgba(232,213,174,.3);
            color: white;
            padding: 11px 17px;
            border-radius: 3px;
            font-size: .82rem;
            transition: .3s;
        }

        .cart-button:hover {
            background: var(--wine-light);
            color: white;
            transform: translateY(-2px);
        }

        .cart-count {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 21px;
            height: 21px;
            border-radius: 50%;
            background: var(--gold);
            color: #17100b;
            font-size: .7rem;
            font-weight: 800;
            margin-left: 6px;
        }

        /* HERO */

        .hero {
            min-height: 640px;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            background: #0f1217;
        }

        /* HERO: tira de videos e imágenes que corre sola, ocupa todo y no recorta nada */
        .hero-slides { position: absolute; inset: 0; z-index: 0; overflow: hidden; }

        .hero-track {
            display: flex;
            height: 100%;
            width: max-content;
            animation: heroScroll 70s linear infinite;
        }

        .hero-track img,
        .hero-track video {
            height: 100%;
            width: auto;
            flex: none;
            display: block;
        }

        @keyframes heroScroll {
            from { transform: translateX(0); }
            to   { transform: translateX(-50%); }
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(90deg, rgba(11,13,17,.96) 0%, rgba(11,13,17,.78) 48%, rgba(11,13,17,.25) 100%);
        }

        @media (prefers-reduced-motion: reduce) {
            .hero-track { animation: none; }
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, var(--bg), transparent 25%, transparent 80%, rgba(0,0,0,.25));
            pointer-events: none;
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
            padding: 95px 0 115px;
        }

        .hero-kicker {
            color: var(--gold-light);
            letter-spacing: 5px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(3.3rem, 7vw, 6.4rem);
            line-height: .99;
            margin: 25px 0;
            font-weight: 600;
        }

        .hero h1 span { color: var(--gold); font-style: italic; }

        .hero p {
            color: #c8c6c0;
            max-width: 520px;
            font-size: 1rem;
            line-height: 1.9;
        }

        .btn-gold {
            background: var(--gold);
            color: #17100b;
            border: 1px solid var(--gold);
            border-radius: 2px;
            padding: 14px 27px;
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: .3s;
        }

        .btn-gold:hover {
            background: var(--gold-light);
            border-color: var(--gold-light);
            color: #17100b;
            transform: translateY(-2px);
        }

        .btn-outline-gold {
            border: 1px solid rgba(232,213,174,.6);
            color: var(--gold-light);
            border-radius: 2px;
            padding: 14px 27px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: .3s;
        }

        .btn-outline-gold:hover {
            background: rgba(212,187,138,.12);
            color: white;
        }

        /* HERO: frases que entran desde la izquierda, una por una */
        .hero h1.hero-phrases {
            display: grid;
            font-size: clamp(2.4rem, 5.4vw, 4.9rem);
            line-height: 1.1;
            margin: 25px 0;
        }

        .hero-phrases .phrase {
            grid-area: 1 / 1;
            font-weight: 600;
            opacity: 0;
            animation: phraseCycle 12s infinite;
            animation-delay: var(--d);
        }

        .hero-phrases .phrase em { color: var(--gold); font-style: italic; }

        @keyframes phraseCycle {
            0%   { opacity: 0; transform: translateX(-150px); }
            6%   { opacity: 1; transform: none; }
            19%  { opacity: 1; transform: none; }
            25%  { opacity: 0; transform: translateX(-150px); }
            100% { opacity: 0; transform: translateX(-150px); }
        }

        @media (max-width: 420px) { .hero h1.hero-phrases { font-size: 2.2rem; } }
        @media (prefers-reduced-motion: reduce) {
            .hero-phrases .phrase { animation: none; }
            .hero-phrases .phrase:first-child { opacity: 1; }
        }

        /* BENEFITS */

        .benefits {
            background: #12151b;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 24px 0;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 13px;
            color: #d9d4c8;
            font-size: .8rem;
        }

        .benefit-item i { color: var(--gold); font-size: 1.2rem; }

        /* COLLECTIONS */

        .collections { padding: 105px 0; }

        .collection-card {
            position: relative;
            height: 390px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--panel);
        }

        .collection-card img,
        .collection-card video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .7s;
            opacity: .75;
        }

        .collection-card:hover img,
        .collection-card:hover video { transform: scale(1.08); }

        .collection-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(9,10,14,.95), transparent 75%);
        }

        .collection-info {
            position: absolute;
            z-index: 2;
            bottom: 28px;
            left: 27px;
        }

        .collection-info small {
            color: var(--gold);
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: .68rem;
        }

        .collection-info h3 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            margin: 8px 0;
        }

        .collection-info a {
            color: var(--cream);
            font-size: .75rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .collection-info a:hover { color: var(--gold); }


        /* PÁGINAS DE COLECCIÓN (Vinos, Licores, Especiales) */

        .col-page { background: var(--bg); padding-bottom: 80px; --acc: var(--gold-light); --glow: rgba(176,40,100,.35); }
        .col-page.t-vinos      { --acc: #e8d5ae; --glow: rgba(176,40,100,.40); --tile: tileUp; }
        .col-page.t-licores    { --acc: #e8a84e; --glow: rgba(226,150,60,.32); --tile: tileLeft; }
        .col-page.t-especiales { --acc: #d9c4ff; --glow: rgba(150,110,230,.38); --tile: tilePop; }

        .col-hero {
            position: relative;
            min-height: 440px;
            display: flex;
            align-items: center;
            padding: 60px 0 70px;
            background: linear-gradient(90deg, rgba(11,13,17,.96) 0%, rgba(11,13,17,.7) 55%, rgba(11,13,17,.35) 100%), var(--bgimg) center/cover;
            border-bottom: 1px solid var(--border);
            overflow: hidden;
        }

        .col-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 82% 30%, var(--glow), transparent 55%), linear-gradient(0deg, var(--bg), transparent 30%);
            pointer-events: none;
        }

        .col-hero .container { position: relative; z-index: 2; }

        .col-back {
            background: transparent;
            border: 1px solid rgba(232,213,174,.45);
            color: var(--gold-light);
            padding: 9px 16px;
            font-size: .72rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: .3s;
        }

        .col-back:hover { background: rgba(212,187,138,.12); color: #fff; }

        .col-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(3.2rem, 8vw, 6.4rem);
            font-weight: 600;
            line-height: 1;
            margin: 14px 0 10px;
            color: var(--acc);
        }

        .col-tag { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.4rem; color: var(--cream); margin: 0 0 8px; }
        .col-desc { color: #c8c6c0; max-width: 560px; line-height: 1.8; }
        .col-count { display: inline-block; margin-top: 8px; color: var(--acc); font-size: .8rem; letter-spacing: 2px; text-transform: uppercase; }
        .col-count i { margin-right: 8px; }

        /* entrada distinta del título en cada colección */
        .t-vinos .col-title      { animation: cVinos 1.2s .55s cubic-bezier(.2,.8,.2,1) both; }
        .t-licores .col-title    { animation: cLic 1s .55s cubic-bezier(.2,.8,.2,1) both; }
        .t-especiales .col-title { animation: cEsp 1.2s .55s cubic-bezier(.2,1.3,.3,1) both; }
        .t-vinos .col-tag, .t-vinos .col-desc           { animation: tileUp .9s .9s both; }
        .t-licores .col-tag, .t-licores .col-desc       { animation: tileLeft .9s .9s both; }
        .t-especiales .col-tag, .t-especiales .col-desc { animation: tilePop .9s .95s both; }

        @keyframes cVinos { from { opacity: 0; transform: translateY(40px); letter-spacing: .22em; } to { opacity: 1; transform: none; letter-spacing: 0; } }
        @keyframes cLic   { from { opacity: 0; transform: translateX(140px) skewX(-8deg); } to { opacity: 1; transform: none; } }
        @keyframes cEsp   { from { opacity: 0; transform: scale(.55); filter: blur(14px); } to { opacity: 1; transform: none; filter: none; } }
        @keyframes tileUp   { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
        @keyframes tileLeft { from { opacity: 0; transform: translateX(-60px); } to { opacity: 1; transform: none; } }
        @keyframes tilePop  { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: none; } }

        /* transición al entrar a cada colección */
        .col-page::before { content: ""; position: fixed; inset: 0; z-index: 1500; pointer-events: none; opacity: 0; }
        .t-vinos::before      { background: linear-gradient(0deg, #6e1038, #b02a68); animation: wipeUp 1.1s cubic-bezier(.7,0,.3,1) both; }
        .t-licores::before    { background: linear-gradient(90deg, #8a4b12, #e8a84e); animation: wipeLeft 1.1s cubic-bezier(.7,0,.3,1) both; }
        .t-especiales::before { background: radial-gradient(circle, #ffffff, #b79cf0 40%, #2a1750 80%); animation: flashIn 1.2s ease both; }
        @keyframes wipeUp   { 0% { opacity: 1; transform: translateY(100%); } 50% { opacity: 1; transform: none; } 100% { opacity: 1; transform: translateY(-100%); } }
        @keyframes wipeLeft { 0% { opacity: 1; transform: translateX(100%); } 50% { opacity: 1; transform: none; } 100% { opacity: 1; transform: translateX(-100%); } }
        @keyframes flashIn  { 0% { opacity: 0; transform: scale(.4); } 35% { opacity: .95; transform: scale(1.1); } 100% { opacity: 0; transform: scale(1.6); } }

        .col-body { padding-top: 55px; }

        .info-tile {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 26px;
            height: 100%;
            animation: var(--tile) .8s cubic-bezier(.2,.8,.2,1) both;
            animation-delay: calc(.9s + var(--k) * 140ms);
        }

        .info-tile i { color: var(--acc); font-size: 1.6rem; margin-bottom: 12px; display: block; }
        .info-tile h5 { font-family: 'Playfair Display', serif; font-size: 1.15rem; margin-bottom: 6px; }
        .info-tile p { color: var(--muted); font-size: .85rem; line-height: 1.7; margin: 0; }

        .col-products { margin-top: 70px; }

        .p-chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin: 22px 0 30px; }

        .p-chip {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: .78rem;
            letter-spacing: 1px;
            transition: .3s;
        }

        .p-chip:hover { color: var(--acc); border-color: var(--acc); }
        .p-chip.active { background: var(--wine); border-color: var(--wine-light); color: #fff; }

        .col-stage { position: relative; }

        /* tarjetas base */
        .p-card {
            background: var(--panel);
            border: 1px solid rgba(212,187,138,.15);
            cursor: pointer;
            text-align: left;
            color: inherit;
            padding: 0;
            position: relative;
            overflow: hidden;
        }

        .p-img { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .p-img img { max-width: 82%; max-height: 92%; object-fit: contain; filter: drop-shadow(0 12px 14px rgba(0,0,0,.55)); transition: transform .6s; }
        .p-img .ph { font-size: 4rem; color: rgba(255,255,255,.25); }

        .p-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            background: var(--wine);
            color: #fff;
            font-size: .6rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 5px 9px;
        }

        .p-info { padding: 16px 18px 20px; }
        .p-info h4 { font-family: 'Playfair Display', serif; font-size: 1.08rem; line-height: 1.3; min-height: 2.8em; margin: 0 0 6px; color: var(--cream); }
        .p-info small { color: var(--muted); font-size: .72rem; }
        .p-price { font-family: 'Playfair Display', serif; color: var(--gold-light); font-size: 1.4rem; font-weight: 700; margin-top: 10px; }
        .p-price.ask { font-size: 1rem; color: var(--muted); font-family: 'DM Sans', sans-serif; font-weight: 500; }
        .p-more { color: var(--acc); font-size: .7rem; letter-spacing: 1.5px; text-transform: uppercase; margin-top: 6px; display: block; }

        /* VINOS: carrusel horizontal, tarjetas que suben */
        .layout-carousel {
            display: flex;
            gap: 22px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            padding: 10px 4px 26px;
            scrollbar-width: thin;
            scrollbar-color: var(--gold) transparent;
        }

        .layout-carousel::-webkit-scrollbar { height: 6px; }
        .layout-carousel::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 6px; }

        .pc-vinos {
            flex: 0 0 255px;
            scroll-snap-align: start;
            animation: pcVinos .9s cubic-bezier(.2,.8,.2,1) both;
            animation-delay: calc(var(--base, 0s) + var(--i) * 110ms);
            transition: transform .4s cubic-bezier(.2,.8,.2,1), border-color .3s, box-shadow .4s;
        }

        .pc-vinos .p-img { height: 270px; background: radial-gradient(circle at 50% 40%, #2a2a36, #14171d 75%); }
        .pc-vinos:hover { transform: translateY(-10px); border-color: rgba(212,187,138,.6); box-shadow: 0 22px 45px rgba(0,0,0,.4); }
        .pc-vinos:hover .p-img img { transform: scale(1.08) rotate(-2deg); }
        @keyframes pcVinos { from { opacity: 0; transform: translateX(170px) rotate(4deg); } to { opacity: 1; transform: none; } }

        .p-arrow {
            position: absolute;
            top: 42%;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--wine);
            border: 1px solid rgba(232,213,174,.4);
            color: #fff;
            z-index: 3;
            transition: .3s;
        }

        .p-arrow:hover { background: var(--wine-light); transform: scale(1.1); }
        .p-arrow.prev { left: -14px; }
        .p-arrow.next { right: -14px; }

        /* LICORES: cuadrícula, tarjetas que giran al entrar */
        .layout-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 22px; perspective: 1200px; }

        .pc-licores {
            animation: pcLic 1s cubic-bezier(.3,1.5,.5,1) both;
            animation-delay: calc(var(--base, 0s) + var(--i) * 100ms);
            transition: transform .4s, box-shadow .4s, border-color .3s;
        }

        .pc-licores .p-img { height: 230px; background: linear-gradient(160deg, #3d2610, #14100c); }
        .pc-licores:hover { transform: translateY(-8px) rotateX(4deg); border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc), 0 18px 40px rgba(226,150,60,.2); }
        .pc-licores:hover .p-img img { transform: rotate(7deg) scale(1.1); }
        @keyframes pcLic { from { opacity: 0; transform: translateY(-190px) rotate(-8deg); } to { opacity: 1; transform: none; } }

        /* ESPECIALES: tarjetas grandes horizontales con destello */
        .layout-feature { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }

        .pc-especiales {
            display: flex;
            animation: pcEsp 1.1s cubic-bezier(.2,1.4,.3,1) both;
            animation-delay: calc(var(--base, 0s) + var(--i) * 120ms);
            transition: transform .4s, border-color .3s, box-shadow .4s;
        }

        .pc-especiales .p-img { flex: 0 0 42%; min-height: 230px; background: radial-gradient(circle at 50% 30%, #4a3270, #140f1c); }
        .pc-especiales .p-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .pc-especiales::after {
            content: "";
            position: absolute;
            top: 0;
            left: -60%;
            width: 40%;
            height: 100%;
            background: linear-gradient(100deg, transparent, rgba(255,255,255,.18), transparent);
            transform: skewX(-20deg);
            transition: left .9s;
            pointer-events: none;
            animation: shineIn 1.2s ease calc(var(--base, 0s) + var(--i) * 120ms + .6s);
        }

        .pc-especiales:hover { transform: scale(1.03); border-color: var(--acc); box-shadow: 0 0 30px rgba(150,110,230,.3); }
        .pc-especiales:hover::after { left: 130%; }
        .pc-especiales:hover .p-img img { transform: scale(1.12); }
        @keyframes pcEsp { from { opacity: 0; transform: scale(.3); filter: blur(14px) brightness(2.2); } to { opacity: 1; transform: none; filter: none; } }
        @keyframes shineIn { from { left: -60%; } to { left: 130%; } }

        /* otras colecciones */
        .col-others { margin-top: 70px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
        .other-link { display: block; background: var(--panel); border: 1px solid var(--border); padding: 22px; transition: .3s; }
        .other-link:hover { border-color: var(--gold); transform: translateY(-4px); }
        .other-link i { color: var(--gold); font-size: 1.4rem; display: block; margin-bottom: 8px; }
        .other-link span { font-family: 'Playfair Display', serif; font-size: 1.3rem; display: block; }
        .other-link small { color: var(--muted); }

        /* VENTANA DE DETALLE: una animación distinta por colección */
        .modal-content.dm-content { background: var(--panel); border: 1px solid var(--border); color: var(--cream); border-radius: 0; overflow: hidden; }
        .dm-img { min-height: 340px; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
        .dm-img img { max-width: 80%; max-height: 420px; object-fit: contain; filter: drop-shadow(0 14px 18px rgba(0,0,0,.6)); }
        .dm-img .ph { font-size: 5rem; color: rgba(255,255,255,.25); }
        .dm-facts { list-style: none; padding: 0; margin: 14px 0 0; font-size: .85rem; color: #c9c6bf; }
        .dm-facts li { padding: 7px 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; gap: 14px; }
        .dm-facts b { color: var(--gold); font-weight: 600; }

        /* vinos: sube desde abajo, la botella "sale" */
        .modal.dm-vinos.fade .modal-dialog { transform: translateY(130px) rotate(3deg); opacity: 0; transition: transform .7s cubic-bezier(.2,.8,.2,1), opacity .5s; }
        .modal.dm-vinos.show .modal-dialog { transform: none; opacity: 1; }
        .dm-vinos .dm-img { background: radial-gradient(circle at 50% 40%, #4a1f3c, #120d14); }
        .modal.dm-vinos.show .dm-img img { animation: rise 1s .2s cubic-bezier(.2,.8,.2,1) both; }
        @keyframes rise { from { transform: translateY(100px) rotate(-8deg); opacity: 0; } to { transform: none; opacity: 1; } }

        /* licores: panel lateral desde la derecha, la botella gira */
        .modal.dm-licores .modal-dialog { --bs-modal-width: 560px; margin: 0 0 0 auto; height: 100%; min-height: 100%; }
        .modal.dm-licores .modal-content { height: 100%; }
        .modal.dm-licores.fade .modal-dialog { transform: translateX(100%); transition: transform .6s cubic-bezier(.2,.8,.2,1); }
        .modal.dm-licores.show .modal-dialog { transform: none; }
        .dm-licores .dm-row > * { flex: 0 0 100%; max-width: 100%; }
        .dm-licores .dm-img { background: linear-gradient(160deg, #3d2610, #14100c); min-height: 300px; }
        .modal.dm-licores.show .dm-img img { animation: spinIn 1s .25s cubic-bezier(.2,.8,.2,1) both; }
        @keyframes spinIn { from { transform: rotateY(180deg) scale(.6); opacity: 0; } to { transform: none; opacity: 1; } }

        /* especiales: aparece con zoom y destello, fondo desenfocado */
        .modal.dm-especiales.fade .modal-dialog { transform: scale(.4); opacity: 0; transition: transform .65s cubic-bezier(.2,1.5,.3,1), opacity .4s; }
        .modal.dm-especiales.show .modal-dialog { transform: none; opacity: 1; }
        .dm-especiales .dm-img { background: radial-gradient(circle at 50% 30%, #4a3270, #140f1c); }
        .dm-especiales .dm-img::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.28) 50%, transparent 70%);
            transform: translateX(-120%);
        }
        .modal.dm-especiales.show .dm-img::after { animation: shine 1.4s .5s ease; }
        .modal.dm-especiales.show .dm-img img { animation: pop .8s .2s cubic-bezier(.2,1.5,.3,1) both; }
        @keyframes shine { to { transform: translateX(120%); } }
        @keyframes pop { from { transform: scale(.3); opacity: 0; } to { transform: none; opacity: 1; } }
        body[data-dm="especiales"] .modal-backdrop.show { backdrop-filter: blur(8px); opacity: .8; }

        @media (max-width: 767px) {
            .pc-vinos { flex-basis: 220px; }
            .pc-vinos .p-img { height: 230px; }
            .p-arrow { display: none; }
            .layout-feature { grid-template-columns: 1fr; }
            .col-hero { min-height: 380px; padding: 40px 0 50px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .p-card, .info-tile, .col-title, .col-tag, .col-desc { animation: none !important; }
            .col-page::before, .pc-especiales::after { display: none; }
        }

        /* RULETA 3D: tipos de bebidas */
        .types-wheel {
            --w: 250px;
            --R: 300px;
            --h: 640px;
            perspective: 1700px;
            height: calc(var(--h) + 60px);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-top: 10px;
        }

        .types-ring {
            position: relative;
            width: var(--w);
            height: var(--h);
            transform-style: preserve-3d;
            animation: ringSpin 36s linear infinite;
        }

        .ring-item {
            position: absolute;
            inset: 0;
            transform: rotateY(calc(var(--k) * 72deg)) translateZ(var(--R));
            backface-visibility: hidden;
        }

        .types-wheel:hover .types-ring { animation-play-state: paused; }
        @keyframes ringSpin { from { transform: rotateY(0deg); } to { transform: rotateY(-360deg); } }

        .type-card { position: relative; }
        .type-link { display: inline-block; margin-top: 12px; color: var(--gold); font-size: .7rem; letter-spacing: 1.5px; text-transform: uppercase; }
        .type-link::after { z-index: 5; }

        @media (max-width: 575px) {
            .types-wheel { --w: 200px; --R: 250px; --h: 620px; }
        }

        @media (prefers-reduced-motion: reduce) { .types-ring { animation: none; } }

        /* DESTILADOS Y AGUARDIENTES: página con ruleta */
        .col-page.t-destilados { --acc: #e3a073; --glow: rgba(214,130,80,.38); --tile: tileSpin; }
        .t-destilados .col-title { animation: cDes 1.1s .55s cubic-bezier(.2,.9,.3,1.2) both; transform-origin: left bottom; }
        .t-destilados .col-tag, .t-destilados .col-desc { animation: tileSpin .9s .9s both; }
        .t-destilados::before { background: conic-gradient(#2a140a, #d98c5f, #2a140a, #d98c5f, #2a140a); animation: spinWipe 1.3s ease both; }
        @keyframes cDes { from { opacity: 0; transform: rotate(-14deg) translateY(50px); } to { opacity: 1; transform: none; } }
        @keyframes tileSpin { from { opacity: 0; transform: rotate(-70deg) scale(.6); } to { opacity: 1; transform: none; } }
        @keyframes spinWipe {
            0%   { opacity: 0; transform: rotate(0deg) scale(.2); }
            40%  { opacity: 1; transform: rotate(270deg) scale(1.7); }
            100% { opacity: 0; transform: rotate(540deg) scale(2.4); }
        }

        .col-stage.rl { overflow: hidden; padding: 30px 0 10px; }

        .rl-bg {
            position: absolute;
            inset: -40px;
            background: center / cover no-repeat;
            filter: blur(38px) brightness(.5) saturate(1.3);
            opacity: .55;
            transform: scale(1.2);
            transition: opacity .35s;
            z-index: 0;
        }

        .rl-bg.swap { opacity: 0; }

        .layout-roulette { position: relative; height: 560px; perspective: 1500px; z-index: 1; }

        .rl-card {
            --rw: 260px;
            position: absolute;
            left: 50%;
            top: 10px;
            width: var(--rw);
            margin-left: calc(var(--rw) / -2);
            transition: transform .9s cubic-bezier(.2,.8,.2,1), opacity .9s, filter .9s;
            will-change: transform, opacity;
        }

        .layout-roulette.rl-intro .rl-card { transition-duration: 1.5s; transition-delay: calc(var(--i) * 90ms + .9s); }
        .pc-destilados .p-img { height: 300px; background: radial-gradient(circle at 50% 40%, #5a3a28, #14100c); }
        .rl-card.active { border-color: var(--acc); box-shadow: 0 0 40px rgba(214,130,80,.3); }
        .rl-card.active .p-img img { transform: scale(1.05); }
        .rl .p-arrow { top: 45%; z-index: 300; display: block; }
        .rl .p-arrow.prev { left: 3%; }
        .rl .p-arrow.next { right: 3%; }

        @media (max-width: 767px) {
            .rl-card { --rw: 215px; }
            .layout-roulette { height: 520px; }
        }

        /* ventana de detalle de destilados: gira al abrir */
        .modal.dm-destilados.fade .modal-dialog { transform: rotate(-200deg) scale(.2); opacity: 0; transition: transform .9s cubic-bezier(.2,.9,.3,1.15), opacity .5s; }
        .modal.dm-destilados.show .modal-dialog { transform: none; opacity: 1; }
        .dm-destilados .dm-img { background: radial-gradient(circle at 50% 40%, #5a3a28, #14100c); }
        .modal.dm-destilados.show .dm-img img { animation: wheelIn 1.1s .25s cubic-bezier(.2,.9,.3,1.1) both; }
        @keyframes wheelIn { from { transform: rotate(-360deg) scale(.3); opacity: 0; } to { transform: none; opacity: 1; } }

        /* PUBLICIDAD: tarjetas con frases que se mueven */
        .promo { padding: 80px 0 90px; background: #0b0d11; border-top: 1px solid var(--border); overflow: hidden; }
        .promo-viewport { overflow: hidden; }
        .promo-track { display: flex; width: max-content; animation: promoScroll 40s linear infinite; }
        .promo:hover .promo-track { animation-play-state: paused; }
        .promo-set { display: flex; gap: 22px; padding-right: 22px; }
        @keyframes promoScroll { from { transform: translateX(0); } to { transform: translateX(-33.3333%); } }

        .ad-card {
            position: relative;
            flex: none;
            width: 300px;
            height: 430px;
            margin: 0;
            overflow: hidden;
            background: #14171d;
            border: 1px solid var(--border);
        }

        .ad-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s; }
        .ad-card:hover img { transform: scale(1.06); }

        .ad-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(8,9,13,.92) 0%, rgba(8,9,13,.35) 45%, transparent 70%);
            pointer-events: none;
        }

        .ad-card figcaption { position: absolute; left: 20px; right: 20px; bottom: 22px; z-index: 2; }
        .ad-card figcaption small { display: block; color: var(--gold); font-size: .62rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px; }
        .ad-card figcaption b { display: block; font-family: 'Playfair Display', serif; font-weight: 600; font-size: 1.55rem; line-height: 1.2; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.7); }

        @media (max-width: 575px) { .ad-card { width: 240px; height: 360px; } }
        @media (prefers-reduced-motion: reduce) { .promo-track { animation: none; } }

        .quick-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
        .quick-links a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border: 1px solid var(--border);
            border-radius: 30px;
            background: rgba(23,26,33,.6);
            color: var(--cream);
            font-size: .78rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: .3s;
        }
        .quick-links a:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-3px); }
        .quick-links i { color: var(--gold); }


        .t-regionales .col-hero::after { content:""; position:absolute; inset:0; background:radial-gradient(circle at 78% 45%, rgba(212,187,138,.22), transparent 28%); animation: regionalPulse 3.6s ease-in-out infinite; pointer-events:none; }
        .t-regionales .spot-slide .spot-img img { animation: regionalBottle 4.8s ease-in-out infinite; }
        .t-vinos_espumantes .st-card { animation: bubblesRise 4.5s ease-in-out infinite; animation-delay: calc(var(--i) * 180ms); }
        @keyframes regionalPulse { 0%,100%{opacity:.35;transform:scale(1)} 50%{opacity:.9;transform:scale(1.12)} }
        @keyframes regionalBottle { 0%,100%{transform:translateY(0) rotate(-1deg) scale(1)} 50%{transform:translateY(-12px) rotate(2deg) scale(1.04)} }
        @keyframes bubblesRise { 0%,100%{filter:brightness(1); transform:translateY(0)} 50%{filter:brightness(1.14); transform:translateY(-7px)} }
        .t-vinos_espumantes .col-title { text-shadow: 0 0 32px rgba(232,213,174,.35); }

        /* LICORES Y CREMAS: ruleta circular con fondo que cambia */
        .layout-orbit { position: relative; height: 640px; overflow: hidden; border: 1px solid var(--border); background: #0b0d11; }

        .ob-bg {
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: translateX(26px);
            transition: opacity 1s ease, transform 1.4s ease;
        }

        .ob-bg.on { opacity: 1; transform: none; }
        .ob-bg::before, .ob-bg::after { content: ""; position: absolute; inset: 0; background-image: var(--img); background-repeat: no-repeat; }
        .ob-bg::before { background-size: cover; background-position: center; filter: blur(30px) brightness(.55); transform: scale(1.15); }
        .ob-bg::after { background-size: contain; background-position: 66% center; }

        .ob-shade {
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(8,9,13,.93) 0%, rgba(8,9,13,.6) 46%, rgba(8,9,13,.12) 100%),
                        linear-gradient(0deg, rgba(8,9,13,.65), transparent 40%);
        }

        .ob-text { position: absolute; left: 48px; top: 50%; transform: translateY(-50%); max-width: 440px; z-index: 3; }
        .ob-text .p-badge { position: static; display: inline-block; margin-bottom: 14px; }
        .ob-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
        .ob-actions .btn-gold, .ob-actions .btn-outline-gold { padding: 12px 20px; }
        .ob-text h3 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; color: #fff; margin: 0 0 8px; text-shadow: 0 2px 16px rgba(0,0,0,.6); }
        .ob-text .p-price { font-size: 2rem; margin: 8px 0 12px; }
        .ob-text .p-price.ask { font-size: 1.1rem; }
        .ob-text p { color: #dcd6ca; line-height: 1.8; font-size: .95rem; }
        .ob-text > * { animation: tileLeft .8s cubic-bezier(.2,.8,.2,1) both; }
        .ob-text > *:nth-child(2) { animation-delay: .08s; }
        .ob-text > *:nth-child(3) { animation-delay: .16s; }
        .ob-text > *:nth-child(4) { animation-delay: .24s; }
        .ob-text > *:nth-child(5) { animation-delay: .32s; }

        .ob-wheel {
            position: absolute;
            left: calc(100% + 40px);
            top: 52%;
            width: 0;
            height: 0;
            z-index: 4;
            animation: obSpin 1.8s .9s cubic-bezier(.2,.8,.2,1) both;
        }

        .ob-wheel.no-intro { animation: none; }
        @keyframes obSpin { from { transform: rotate(-150deg); opacity: 0; } to { transform: none; opacity: 1; } }

        .ob-item {
            --d: 250px;
            position: absolute;
            left: 0;
            top: 0;
            width: var(--d);
            height: var(--d);
            margin: calc(var(--d) / -2) 0 0 calc(var(--d) / -2);
            padding: 0;
            border-radius: 50%;
            background: center / cover no-repeat #14171d;
            border: 2px solid rgba(255,255,255,.38);
            box-shadow: 0 10px 30px rgba(0,0,0,.55);
            cursor: pointer;
            transition: transform 1.1s cubic-bezier(.3,.9,.3,1), opacity .8s, border-color .5s, box-shadow .5s;
            will-change: transform;
        }

        .ob-item:hover { border-color: #fff; }
        .ob-item.active { border-color: var(--acc); box-shadow: 0 0 0 6px rgba(232,168,78,.18), 0 0 50px rgba(232,168,78,.45); animation: obPulse 2.6s ease-in-out infinite; }
        @keyframes obPulse { 50% { box-shadow: 0 0 0 12px rgba(232,168,78,.10), 0 0 70px rgba(232,168,78,.6); } }

        .ob-count { position: absolute; left: 48px; bottom: 22px; z-index: 5; color: var(--acc); font-size: .8rem; letter-spacing: 4px; }
        .ob-nav { position: absolute; right: 22px; bottom: 20px; z-index: 6; display: flex; gap: 10px; }
        .ob-nav button { width: 44px; height: 44px; border-radius: 50%; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.4); color: #fff; transition: .3s; }
        .ob-nav button:hover { background: var(--wine); transform: scale(1.1); }

        @media (max-width: 767px) {
            .layout-orbit { height: 700px; }
            .ob-text { left: 20px; right: 20px; top: 28px; transform: none; max-width: none; text-align: center; }
            .ob-wheel { left: 50%; top: calc(100% + 70px); }
            .ob-item { --d: 150px; }
            .ob-shade { background: linear-gradient(0deg, rgba(8,9,13,.45), rgba(8,9,13,.88)); }
            .ob-count { display: none; }
        }

        @media (prefers-reduced-motion: reduce) { .ob-wheel { animation: none; } .ob-item.active { animation: none; } }

        /* CERVEZAS: escaparate con espuma y burbujas */
        .col-page.t-cervezas { --acc: #f5b638; --glow: rgba(245,182,56,.40); --tile: tileFizz; }
        .t-cervezas .col-title { animation: cBeer 1.2s 1.9s cubic-bezier(.2,1.4,.3,1) both; }
        .t-cervezas .col-tag, .t-cervezas .col-desc { animation: tileFizz .9s 2.2s both; }
        .t-cervezas .info-tile { animation-delay: calc(2.3s + var(--k) * 140ms); }
        .t-cervezas::before { display: none; }
        @keyframes cBeer { from { opacity: 0; transform: translateY(-70px) scaleY(1.3); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
        @keyframes tileFizz { from { opacity: 0; transform: translateY(50px) rotate(3deg); } to { opacity: 1; transform: none; } }

        .bubbles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }
        .bubbles i {
            position: absolute;
            bottom: -40px;
            left: var(--x);
            width: var(--s);
            height: var(--s);
            border-radius: 50%;
            border: 1px solid rgba(255,235,180,.55);
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.55), rgba(255,255,255,.04));
            animation: bubbleUp var(--d) linear infinite;
            animation-delay: var(--dl);
        }
        @keyframes bubbleUp {
            0%   { transform: translate(0, 0); opacity: 0; }
            10%  { opacity: .85; }
            100% { transform: translate(var(--dx), -700px); opacity: 0; }
        }

        .foam {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 26px;
            z-index: 1;
            background: radial-gradient(circle at 14px 26px, #fff6dc 13px, transparent 14px) 0 0 / 28px 26px repeat-x;
            opacity: .95;
        }

        .layout-spot {
            position: relative;
            height: 640px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: #0b0d11;
        }

        .t-cervezas .layout-spot { animation: fillUp 1.3s 2.4s cubic-bezier(.2,.8,.2,1) both; }
        @keyframes fillUp { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }

        .layout-spot::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 24px;
            z-index: 6;
            background: radial-gradient(circle at 14px 0, #fff6dc 13px, transparent 14px) 0 0 / 28px 24px repeat-x;
            opacity: .95;
        }

        .spot-bg {
            position: absolute;
            inset: -40px;
            background: center / cover no-repeat;
            filter: blur(34px) brightness(.45) saturate(1.3);
            opacity: .65;
            transform: scale(1.2);
            transition: opacity .4s;
        }

        .spot-bg.swap { opacity: 0; }

        .spot-slide {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            bottom: 120px;
            display: flex;
            align-items: center;
            gap: 40px;
            padding: 44px 70px 20px;
            z-index: 2;
            opacity: 0;
            transform: translateX(90px);
            transition: opacity .8s, transform .9s cubic-bezier(.2,.8,.2,1);
            pointer-events: none;
        }

        .spot-slide.prev { transform: translateX(-90px); }
        .spot-slide.active { opacity: 1; transform: none; pointer-events: auto; }

        .spot-text { flex: 1; min-width: 0; }
        .spot-text h3 { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.1; margin: 0 0 6px; color: #fff; }
        .spot-text .p-price { font-size: 2.2rem; margin: 10px 0 12px; }
        .spot-text .p-price.ask { font-size: 1.15rem; }
        .spot-text p { color: #cfcac0; max-width: 420px; line-height: 1.8; font-size: .9rem; }
        .sp-badge { position: static; display: inline-block; margin-bottom: 14px; }
        .spot-slide.active .spot-text > * { animation: tileUp .8s .25s both; }

        .spot-img { flex: 0 0 42%; height: 100%; display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .spot-img img { max-width: 100%; max-height: 96%; object-fit: contain; filter: drop-shadow(0 26px 30px rgba(0,0,0,.6)); }
        .spot-img .ph { font-size: 7rem; color: rgba(255,255,255,.25); }
        .spot-slide.active .spot-img img { animation: fizzUp .9s cubic-bezier(.2,.8,.2,1) both, floaty 5s ease-in-out .9s infinite; }
        @keyframes fizzUp { from { transform: translateY(90px) scale(.8); opacity: 0; } to { transform: none; opacity: 1; } }
        @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }

        .spot-thumbs {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 120px;
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: center;
            padding: 10px 20px;
            z-index: 4;
            background: rgba(8,9,13,.7);
            border-top: 1px solid var(--border);
        }

        .sp-thumb {
            width: 70px;
            height: 94px;
            padding: 4px;
            background: #14171d;
            border: 1px solid var(--border);
            opacity: .55;
            transition: .3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sp-thumb img { width: 100%; height: 100%; object-fit: contain; }
        .sp-thumb .ph { font-size: 1.6rem; color: rgba(255,255,255,.3); }
        .sp-thumb:hover { opacity: .9; transform: translateY(-4px); }
        .sp-thumb.active { opacity: 1; border-color: var(--acc); box-shadow: 0 0 18px rgba(245,182,56,.35); }

        .layout-spot .p-arrow { top: 42%; z-index: 7; display: block; }
        .layout-spot .p-arrow.prev { left: 16px; }
        .layout-spot .p-arrow.next { right: 16px; }

        @media (max-width: 767px) {
            .layout-spot { height: 720px; }
            .spot-slide { flex-direction: column-reverse; padding: 36px 24px 10px; gap: 6px; text-align: center; bottom: 100px; }
            .spot-img { flex: 1; width: 100%; min-height: 0; }
            .spot-text { flex: 0 0 auto; }
            .spot-text p { margin-left: auto; margin-right: auto; }
            .spot-thumbs { height: 100px; }
            .sp-thumb { width: 56px; height: 76px; }
        }

        /* BRINDIS: al entrar a Cervezas sube la cerveza, chocan dos jarras y baja el nivel */
        .beer-intro { position: fixed; inset: 0; z-index: 2500; pointer-events: none; overflow: hidden; animation: biLife 3s linear forwards; }
        @keyframes biLife { 0%, 96% { opacity: 1; } 100% { opacity: 0; } }

        .bi-liquid {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 100%;
            background: linear-gradient(0deg, #8a4f0c, #f5b638 82%);
            transform: translateY(100%);
            animation: biRise 3s cubic-bezier(.5,0,.3,1) forwards;
        }

        @keyframes biRise {
            0%   { transform: translateY(100%); }
            35%  { transform: translateY(0); }
            60%  { transform: translateY(0); }
            96%  { transform: translateY(104%); }
            100% { transform: translateY(104%); }
        }

        .bi-wave { position: absolute; top: -58px; left: 0; width: 200%; height: 60px; animation: biWave 1.4s linear infinite; }
        @keyframes biWave { from { transform: translateX(0); } to { transform: translateX(-50%); } }

        .bi-mugs { position: absolute; left: 0; right: 0; top: 50%; height: 0; }
        .bi-mugs i {
            position: absolute;
            top: 0;
            margin-top: -4.2rem;
            font-size: 7rem;
            color: #fff6dc;
            text-shadow: 0 0 30px rgba(255,255,255,.55);
            opacity: 0;
        }

        .bi-l { left: calc(50% - 6.6rem); animation: biL 3s ease forwards; }
        .bi-r { left: calc(50% - .4rem); animation: biR 3s ease forwards; }

        @keyframes biL {
            0%, 14% { transform: translateX(-60vw) rotate(-35deg); opacity: 0; }
            22%     { opacity: 1; }
            38%     { transform: translateX(0) rotate(-6deg); }
            42%     { transform: translateX(16px) rotate(9deg); }
            48%     { transform: translateX(0) rotate(-3deg); opacity: 1; }
            62%     { transform: translateX(0) rotate(-3deg); opacity: 1; }
            68%, 100% { transform: translateX(0) rotate(-3deg); opacity: 0; }
        }

        @keyframes biR {
            0%, 14% { transform: scaleX(-1) translateX(-60vw) rotate(-35deg); opacity: 0; }
            22%     { opacity: 1; }
            38%     { transform: scaleX(-1) translateX(0) rotate(-6deg); }
            42%     { transform: scaleX(-1) translateX(16px) rotate(9deg); }
            48%     { transform: scaleX(-1) translateX(0) rotate(-3deg); opacity: 1; }
            62%     { transform: scaleX(-1) translateX(0) rotate(-3deg); opacity: 1; }
            68%, 100% { transform: scaleX(-1) translateX(0) rotate(-3deg); opacity: 0; }
        }

        .bi-spark {
            position: absolute;
            left: 50%;
            top: -3.6rem;
            width: 26px;
            height: 26px;
            margin: -13px;
            border: 3px solid #fff;
            border-radius: 50%;
            opacity: 0;
            animation: biSpark 3s ease-out forwards;
        }

        @keyframes biSpark {
            0%, 39% { opacity: 0; transform: scale(.2); }
            41%     { opacity: 1; transform: scale(1); }
            60%, 100% { opacity: 0; transform: scale(11); }
        }

        .bi-text {
            position: absolute;
            left: 0;
            right: 0;
            top: calc(50% + 4.6rem);
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: clamp(2.6rem, 8vw, 5.4rem);
            color: #2a1604;
            opacity: 0;
            animation: biText 3s ease forwards;
        }

        @keyframes biText {
            0%, 40% { opacity: 0; transform: scale(.4); }
            46%     { opacity: 1; transform: scale(1.15); }
            52%     { transform: scale(1); }
            62%     { opacity: 1; }
            68%, 100% { opacity: 0; }
        }

        @media (max-width: 575px) { .bi-mugs i { font-size: 4.6rem; margin-top: -2.8rem; } .bi-l { left: calc(50% - 4.4rem); } .bi-r { left: calc(50% - .3rem); } }
        @media (prefers-reduced-motion: reduce) { .beer-intro { display: none; } }

        /* ventana de detalle de cervezas: cae con rebote y la botella se "llena" */
        .modal.dm-cervezas.fade .modal-dialog { transform: translateY(-170px) scale(.9); opacity: 0; transition: transform .8s cubic-bezier(.3,1.6,.5,1), opacity .4s; }
        .modal.dm-cervezas.show .modal-dialog { transform: none; opacity: 1; }
        .dm-cervezas .dm-img { background: radial-gradient(circle at 50% 40%, #8a5a14, #1c1409); }
        .modal.dm-cervezas.show .dm-img img { transform-origin: bottom; animation: fillBottle 1s .2s cubic-bezier(.2,.8,.2,1) both; }
        @keyframes fillBottle { from { transform: scaleY(.1); opacity: 0; } to { transform: none; opacity: 1; } }

        @media (prefers-reduced-motion: reduce) {
            .bubbles i, .spot-slide.active .spot-img img { animation: none; }
            .t-cervezas .layout-spot { animation: none; }
        }

        /* ESPECIALES: carrusel de imágenes curvo */
        .layout-curve { position: relative; height: 660px; overflow: hidden; border: 1px solid var(--border); background: #0b0d11; }

        .cv-bg {
            position: absolute;
            inset: -20px;
            background: center / cover no-repeat;
            filter: brightness(.36) saturate(1.2);
            transform: scale(1.08);
            animation: cvDrift 20s ease-in-out infinite alternate;
        }

        @keyframes cvDrift { to { transform: scale(1.15) translateX(-22px); } }

        .cv-shade { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 42%, transparent 25%, rgba(8,9,13,.88) 100%); }

        .cv-stage {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 470px;
            perspective: 1100px;
            -webkit-mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 13%, #000 87%, transparent);
        }

        .cv-card {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 210px;
            height: 300px;
            margin: -150px 0 0 -105px;
            padding: 0;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.2);
            background: center / cover no-repeat #14171d;
            box-shadow: 0 18px 40px rgba(0,0,0,.55);
            cursor: pointer;
            transition: transform .65s cubic-bezier(.3,.9,.3,1), opacity .5s, border-color .4s, box-shadow .4s;
            will-change: transform;
        }

        .cv-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(6,7,10,.9), transparent 55%); }
        .cv-label { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 2; text-align: left; color: #fff; }
        .cv-label b { display: block; font-family: 'Playfair Display', serif; font-size: .98rem; line-height: 1.2; }
        .cv-label span { color: var(--gold-light); font-size: .85rem; font-weight: 700; }
        .cv-card.active { border-color: var(--acc); box-shadow: 0 0 0 3px rgba(217,196,255,.25), 0 0 44px rgba(150,110,230,.55); }
        .layout-curve.cv-intro .cv-card { transition-duration: 1.2s; transition-delay: calc(var(--i) * 70ms + .9s); }

        .cv-info {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 190px;
            z-index: 5;
            text-align: center;
            padding: 6px 70px 0;
        }

        .cv-info > * { animation: tilePop .5s cubic-bezier(.2,.9,.3,1.2) both; }
        .cv-info .p-badge { position: static; display: inline-block; margin-bottom: 8px; }
        .cv-info h3 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2.2rem); color: #fff; margin: 0; }
        .cv-info .p-price { font-size: 1.7rem; margin: 4px 0 6px; }
        .cv-info p { color: #d8d2c6; font-size: .88rem; margin: 0 0 10px; }
        .cv-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .cv-actions .btn-gold, .cv-actions .btn-outline-gold { padding: 11px 20px; }

        .cv-nav { position: absolute; left: 16px; right: 16px; top: 205px; z-index: 6; display: flex; justify-content: space-between; pointer-events: none; }
        .cv-nav button { pointer-events: auto; width: 46px; height: 46px; border-radius: 50%; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.4); color: #fff; transition: .3s; }
        .cv-nav button:hover { background: var(--wine); transform: scale(1.1); }

        .col-page.t-especiales .col-title { text-shadow: 0 0 40px rgba(150,110,230,.5); }

        @media (max-width: 767px) {
            .layout-curve { height: 680px; }
            .cv-stage { height: 400px; }
            .cv-card { width: 160px; height: 230px; margin: -115px 0 0 -80px; }
            .cv-info { height: 250px; padding: 0 18px; }
            .cv-nav { top: 170px; }
        }

        @media (prefers-reduced-motion: reduce) { .cv-bg { animation: none; } .cv-info > * { animation: none; } }

        /* CARRITO */
        .cart-count.bump { animation: bump .5s cubic-bezier(.2,1.6,.3,1); }
        @keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.7); } 100% { transform: scale(1); } }

        .cart-item { align-items: flex-start; }
        .ci-thumb { flex: 0 0 72px; height: 86px; background: var(--panel-light); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--border); }
        .ci-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .ci-thumb i { color: var(--gold); font-size: 1.6rem; }
        .ci-name { font-family: 'Playfair Display', serif; font-size: 1rem; margin: 0 0 2px; }
        .ci-price { color: var(--gold-light); font-weight: 700; font-size: .9rem; }
        .ci-del { background: none; border: 0; color: #c0586f; font-size: .85rem; padding: 4px 6px; }
        .ci-del:hover { color: #ff7a93; }

        .qty { display: inline-flex; align-items: center; gap: 14px; }
        .qty button { width: 42px; height: 42px; border-radius: 50%; background: transparent; border: 1px solid rgba(212,187,138,.45); color: var(--cream); font-size: 1.3rem; line-height: 1; transition: .25s; }
        .qty button:hover { background: var(--wine); border-color: var(--wine-light); transform: scale(1.08); }
        .qty button:active { transform: scale(.92); }
        .qty span { min-width: 40px; text-align: center; font-weight: 700; font-size: 1.25rem; font-family: 'Playfair Display', serif; color: #fff; }
        .qty-label { display: block; color: var(--muted); font-size: .68rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; }

        .dm-buy { display: flex; align-items: flex-end; gap: 22px; flex-wrap: wrap; }

        .cart-toast {
            position: fixed;
            left: 50%;
            bottom: 26px;
            z-index: 4500;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #14171d;
            border: 1px solid var(--gold);
            color: var(--cream);
            padding: 12px 18px;
            border-radius: 40px;
            box-shadow: 0 14px 40px rgba(0,0,0,.6), 0 0 24px rgba(176,42,104,.35);
            transform: translate(-50%, 140%);
            opacity: 0;
            transition: transform .55s cubic-bezier(.2,1.4,.3,1), opacity .4s;
            max-width: 92vw;
        }

        .cart-toast.show { transform: translate(-50%, 0); opacity: 1; }
        .cart-toast i { color: #5fd38d; font-size: 1.2rem; }
        .cart-toast span { font-size: .85rem; }
        .cart-toast button { background: var(--gold); color: #17100b; border: 0; border-radius: 20px; padding: 6px 14px; font-size: .72rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }

        .fly-dot { position: fixed; z-index: 4600; width: 18px; height: 18px; border-radius: 50%; background: var(--wine-light); box-shadow: 0 0 18px rgba(176,42,104,.9); pointer-events: none; }

        /* FINALIZAR COMPRA */
        .co-content { background: var(--panel); border: 1px solid var(--border); color: var(--cream); border-radius: 0; }
        .co-head { border-bottom: 1px solid var(--border); }
        .co-block { background: #12151b; border: 1px solid var(--border); padding: 22px; margin-bottom: 18px; }
        .co-block h6, .co-summary h6 { font-family: 'Playfair Display', serif; font-size: 1.1rem; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
        .co-block h6 span { width: 26px; height: 26px; border-radius: 50%; background: var(--wine); color: #fff; font-family: 'DM Sans', sans-serif; font-size: .8rem; display: inline-flex; align-items: center; justify-content: center; }
        .co-block label, .co-summary label { color: #d4cfc3; font-size: .75rem; margin-bottom: 6px; display: block; }
        .co-err { display: none; color: #ff7a93; font-size: .72rem; margin-top: 5px; }
        .form-control-dark.invalid { border-color: #ff7a93; }
        .form-control-dark.invalid + .co-err, .co-err.show { display: block; }

        .co-seg { display: flex; gap: 8px; }
        .co-seg label { flex: 1; margin: 0; cursor: pointer; }
        .co-seg input { display: none; }
        .co-seg span { display: block; text-align: center; padding: 11px 8px; border: 1px solid rgba(212,187,138,.25); font-size: .8rem; color: var(--muted); transition: .25s; }
        .co-seg input:checked + span { background: var(--wine); border-color: var(--wine-light); color: #fff; }

        .pay-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .pay-tile { margin: 0 !important; cursor: pointer; }
        .pay-tile input { display: none; }
        .pay-tile > span { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; padding: 16px 8px; border: 1px solid rgba(212,187,138,.25); transition: .3s; height: 100%; }
        .pay-tile i { font-size: 1.5rem; margin-bottom: 4px; }
        .pay-tile b { font-size: .88rem; color: var(--cream); }
        .pay-tile small { color: var(--muted); font-size: .66rem; }
        .pay-yape i { color: #a35cd0; }
        .pay-plin i { color: #19d3c5; }
        .pay-card i { color: var(--gold); }
        .pay-tile:hover > span { transform: translateY(-3px); border-color: var(--gold); }
        .pay-tile input:checked + span { border-color: var(--gold-light); background: rgba(138,28,76,.35); box-shadow: 0 0 24px rgba(176,42,104,.35); transform: translateY(-3px); }

        .pay-detail { margin-top: 14px; font-size: .85rem; color: #d8d2c6; line-height: 1.7; min-height: 0; }
        .pay-detail .pd { border: 1px dashed var(--gold); background: rgba(212,187,138,.06); padding: 14px 16px; animation: tileUp .4s both; }
        .pay-detail .pd b { color: var(--gold-light); }
        .pay-detail .pd .pd-num { display: inline-block; font-size: 1.3rem; letter-spacing: 3px; color: #fff; margin: 4px 0; }

        .co-summary { background: #12151b; border: 1px solid var(--border); padding: 22px; position: sticky; top: 0; }
        .co-items { list-style: none; padding: 0; margin: 0 0 12px; max-height: 260px; overflow: auto; }
        .co-items li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: .82rem; }
        .co-items li b { color: var(--gold-light); white-space: nowrap; }
        .co-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: .85rem; color: #c9c6bf; }
        .co-row small { color: var(--muted); }
        .co-total { border-top: 1px solid var(--border); margin-top: 6px; padding-top: 12px; font-size: 1rem; color: #fff; }
        .co-total b { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--gold-light); }

        /* PEDIDO CONFIRMADO: animación de celebración */
        .order-done { position: fixed; inset: 0; z-index: 6000; display: flex; align-items: center; justify-content: center; padding: 20px; overflow-y: auto; }
        .od-bg { position: absolute; inset: 0; background: radial-gradient(circle at 50% 38%, rgba(138,28,76,.55), rgba(9,10,14,.96) 62%); backdrop-filter: blur(8px); animation: odFade .7s ease both; }
        @keyframes odFade { from { opacity: 0; } to { opacity: 1; } }
        .od-confetti { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
        .od-confetti i { position: absolute; top: -5vh; left: var(--x); width: var(--w); height: var(--h); background: var(--c); opacity: 0; animation: confFall var(--t) cubic-bezier(.3,.6,.4,1) var(--d) forwards; }
        @keyframes confFall {
            0%   { transform: translate3d(0, 0, 0) rotate(0); opacity: 1; }
            100% { transform: translate3d(var(--dx), 112vh, 0) rotate(var(--r)); opacity: 1; }
        }

        .od-card {
            position: relative;
            width: min(500px, 100%);
            background: linear-gradient(160deg, #1a1d25, #101319);
            border: 1px solid rgba(212,187,138,.4);
            padding: 38px 30px 30px;
            text-align: center;
            box-shadow: 0 30px 90px rgba(0,0,0,.7), 0 0 60px rgba(176,42,104,.35);
            animation: odPop .9s .25s cubic-bezier(.2,1.4,.3,1) both;
        }

        @keyframes odPop { from { opacity: 0; transform: translateY(70px) scale(.7) rotate(-3deg); } to { opacity: 1; transform: none; } }

        .od-seal { position: relative; width: 120px; height: 120px; margin: -92px auto 14px; background: #14171d; border-radius: 50%; box-shadow: 0 0 0 6px rgba(176,42,104,.25), 0 0 50px rgba(176,42,104,.7); }
        .od-seal svg { width: 100%; height: 100%; }
        .od-ring { fill: none; stroke: var(--wine-light); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 327; stroke-dashoffset: 327; transform: rotate(-90deg); transform-origin: 50% 50%; animation: odDraw 1s .6s ease forwards; }
        .od-check { fill: none; stroke: var(--gold-light); stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 90; stroke-dashoffset: 90; animation: odDraw .6s 1.5s ease forwards; }
        @keyframes odDraw { to { stroke-dashoffset: 0; } }
        .od-seal::before, .od-seal::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--wine-light); opacity: 0; animation: odPulse 2.2s 1.6s ease-out infinite; }
        .od-seal::after { animation-delay: 2.3s; }
        @keyframes odPulse { 0% { opacity: .8; transform: scale(1); } 100% { opacity: 0; transform: scale(2); } }

        .od-rays { position: absolute; inset: 0; pointer-events: none; }
        .od-rays i { position: absolute; left: 50%; top: 50%; width: 3px; height: 16px; margin: -8px 0 0 -1.5px; background: var(--gold-light); border-radius: 2px; opacity: 0; transform: rotate(var(--a)) translateY(-70px); animation: odRay .9s 1.55s ease-out forwards; }
        @keyframes odRay { 0% { opacity: 1; transform: rotate(var(--a)) translateY(-62px); } 100% { opacity: 0; transform: rotate(var(--a)) translateY(-112px); } }

        .od-title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 6vw, 2.5rem); margin: 6px 0 6px; background: linear-gradient(90deg, #fff, var(--gold-light), #fff); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: odShine 3s 1.2s linear infinite, tileUp .8s 1s both; }
        @keyframes odShine { to { background-position: 200% center; } }
        .od-sub { color: #cfcac0; font-size: .92rem; animation: tileUp .8s 1.15s both; }
        .od-sub b { color: var(--gold-light); }
        .od-order { display: inline-flex; gap: 10px; align-items: center; border: 1px solid var(--border); padding: 7px 16px; margin: 4px 0 14px; font-size: .78rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); animation: tileUp .8s 1.3s both; }
        .od-order b { color: #fff; letter-spacing: 3px; }
        .od-items { list-style: none; padding: 0; margin: 0 0 8px; text-align: left; max-height: 170px; overflow: auto; }
        .od-items li { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: .83rem; opacity: 0; animation: odRow .5s calc(1.5s + var(--n) * .12s) both; }
        .od-items li b { color: var(--gold-light); white-space: nowrap; }
        @keyframes odRow { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: none; } }
        .od-total { display: flex; justify-content: space-between; align-items: baseline; padding: 8px 0 4px; font-size: .95rem; animation: tileUp .8s 1.8s both; }
        .od-total b { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--gold-light); }
        .od-pay { color: var(--muted); font-size: .78rem; line-height: 1.6; margin: 6px 0 16px; animation: tileUp .8s 1.9s both; }
        .od-wa { display: block; animation: tileUp .8s 2s both; box-shadow: 0 0 30px rgba(176,42,104,.45); }
        .od-close { display: block; width: 100%; margin-top: 10px; animation: tileUp .8s 2.1s both; }

        @media (prefers-reduced-motion: reduce) {
            .od-confetti { display: none; }
            .od-card, .od-title, .od-sub, .od-order, .od-total, .od-pay, .od-wa, .od-close, .od-items li { animation: none; opacity: 1; }
            .od-ring, .od-check { animation: none; stroke-dashoffset: 0; }
        }

        /* TIENDA */
        .store { padding: 80px 0; background: #0b0d11; border-top: 1px solid var(--border); }

        .store-gallery {
            display: grid;
            grid-template-columns: 1.3fr 1fr 1fr;
            grid-template-rows: 140px 140px;
            gap: 12px;
            max-width: 860px;
            margin: 0 auto;
        }

        .sg { position: relative; margin: 0; overflow: hidden; border: 1px solid var(--border); background: #14171d; opacity: 0; transform: translateY(50px) scale(.96); transition: opacity .9s ease, transform .9s cubic-bezier(.2,.8,.2,1); }
        .sg.in { opacity: 1; transform: none; }
        .sg-a { grid-row: 1 / span 2; }
        .sg-d { grid-column: 2 / span 2; }
        .sg img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
        .sg:hover img { transform: scale(1.07); }
        .sg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,9,13,.85), transparent 55%); pointer-events: none; }
        .sg figcaption { position: absolute; left: 14px; bottom: 11px; z-index: 2; }
        .sg figcaption small { display: block; color: var(--gold); font-size: .62rem; letter-spacing: 3px; text-transform: uppercase; }
        .sg figcaption b { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 600; color: #fff; }

        .si-card { background: var(--panel); border: 1px solid var(--border); padding: 20px; height: 100%; transition: .35s; }
        .si-card:hover { transform: translateY(-6px); border-color: var(--gold); box-shadow: 0 16px 40px rgba(0,0,0,.35); }
        .si-card > i { color: var(--gold); font-size: 1.7rem; margin-bottom: 14px; display: block; }
        .si-card h5 { font-family: 'Playfair Display', serif; font-size: 1.15rem; }
        .si-card p { color: #d8d2c6; font-size: .88rem; line-height: 1.6; margin: 0 0 4px; }
        .si-card .si-sub { color: var(--muted); font-size: .76rem; }
        .si-card a { color: var(--gold-light); }
        .si-pay { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px !important; }
        .si-pay span { border: 1px solid var(--border); padding: 4px 10px; font-size: .7rem; color: var(--cream); border-radius: 20px; }
        .si-pay i { color: var(--gold); margin-right: 4px; }

        @media (max-width: 767px) {
            .store { padding: 70px 0; }
            .store-gallery { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-rows: 130px; }
            .sg-a { grid-row: auto; }
            .sg-d { grid-column: auto; }
            .pay-grid { grid-template-columns: 1fr; }
        }

        @media (prefers-reduced-motion: reduce) { .sg { opacity: 1; transform: none; transition: none; } }

        /* LICORES: baraja de cartas que se lanzan */
        .col-page.t-licoreria { --acc: #f2c46d; --glow: rgba(242,196,109,.34); --tile: tileFlip; }
        .t-licoreria .col-title { animation: cLic2 1.1s .6s cubic-bezier(.2,1.3,.3,1) both; }
        .t-licoreria .col-tag, .t-licoreria .col-desc { animation: tileFlip .9s .95s both; }
        .t-licoreria::before { background: linear-gradient(135deg, #4a0f2e, #b02a68 55%, #f2c46d); animation: irisIn 1.2s cubic-bezier(.6,0,.3,1) both; }
        @keyframes cLic2 { from { opacity: 0; transform: translateY(-70px) rotateX(70deg); } to { opacity: 1; transform: none; } }
        @keyframes tileFlip { from { opacity: 0; transform: perspective(600px) rotateX(-70deg) translateY(-20px); } to { opacity: 1; transform: none; } }
        @keyframes irisIn { 0% { opacity: 1; clip-path: circle(0% at 50% 50%); } 55% { opacity: 1; clip-path: circle(150% at 50% 50%); } 100% { opacity: 0; clip-path: circle(150% at 50% 50%); } }

        .layout-stack { position: relative; height: 600px; overflow: hidden; border: 1px solid var(--border); background: #0b0d11; }
        .st-bg { position: absolute; inset: -30px; background: var(--img) center / cover no-repeat; filter: blur(36px) brightness(.4) saturate(1.3); transition: opacity .5s; }
        .st-bg.swap { opacity: 0; }
        .st-info { position: absolute; left: 48px; top: 50%; transform: translateY(-50%); max-width: 400px; z-index: 5; }
        .st-info .p-badge { position: static; display: inline-block; margin-bottom: 14px; }
        .st-info h3 { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.1; color: #fff; margin: 0 0 8px; }
        .st-info .p-price { font-size: 2rem; margin: 8px 0 12px; }
        .st-info p { color: #d8d2c6; line-height: 1.8; font-size: .92rem; }
        .st-info > * { animation: tileFlip .6s cubic-bezier(.2,.9,.3,1) both; }
        .st-info > *:nth-child(2) { animation-delay: .07s; }
        .st-info > *:nth-child(3) { animation-delay: .14s; }
        .st-info > *:nth-child(4) { animation-delay: .21s; }
        .st-info > *:nth-child(5) { animation-delay: .28s; }
        .st-count { position: absolute; left: 48px; bottom: 20px; z-index: 6; color: var(--acc); font-size: .8rem; letter-spacing: 4px; }
        .st-nav { position: absolute; right: 22px; bottom: 18px; z-index: 6; display: flex; gap: 10px; }
        .st-nav button { width: 44px; height: 44px; border-radius: 50%; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.4); color: #fff; transition: .3s; }
        .st-nav button:hover { background: var(--wine); transform: scale(1.1); }

        .st-deck { position: absolute; right: 80px; top: 50%; width: 400px; height: 310px; margin-top: -155px; z-index: 3; }
        .st-card {
            position: absolute;
            inset: 0;
            padding: 0;
            border-radius: 16px;
            overflow: hidden;
            background: var(--img) center / cover no-repeat #14171d;
            border: 1px solid rgba(255,255,255,.22);
            box-shadow: 0 22px 50px rgba(0,0,0,.6);
            cursor: pointer;
            transition: transform .7s cubic-bezier(.3,.9,.3,1), opacity .6s;
            will-change: transform;
        }
        .st-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(6,7,10,.9), transparent 55%); }
        .st-card .cv-label { left: 18px; bottom: 14px; }
        .st-card .cv-label b { font-size: 1.15rem; }
        .st-card.fly { transform: translate(-70%, 60px) rotate(-26deg) !important; opacity: 0 !important; transition: transform .55s cubic-bezier(.5,0,.8,.4), opacity .55s; }
        .layout-stack.st-intro .st-card { transition: transform 1.1s cubic-bezier(.3,1.5,.5,1), opacity .6s; transition-delay: calc(var(--i) * 90ms + .9s); }

        @media (max-width: 767px) {
            .layout-stack { height: 700px; }
            .st-info { left: 20px; right: 20px; top: auto; bottom: 74px; transform: none; max-width: none; text-align: center; }
            .st-info .p-price { margin: 4px 0 6px; font-size: 1.5rem; }
            .st-info p { display: none; }
            .st-deck { right: 50%; margin-right: -140px; width: 280px; height: 220px; top: 40px; margin-top: 0; }
            .st-count { display: none; }
        }

        /* ventana de detalle de Licores: se abre como una carta que cae */
        .modal.dm-licoreria.fade .modal-dialog { transform: perspective(1000px) rotateX(-80deg) translateY(-60px); transform-origin: top center; opacity: 0; transition: transform .8s cubic-bezier(.2,1.2,.3,1), opacity .5s; }
        .modal.dm-licoreria.show .modal-dialog { transform: none; opacity: 1; }
        .dm-licoreria .dm-img { background: radial-gradient(circle at 50% 40%, #4a2a12, #120d08); }
        .modal.dm-licoreria.show .dm-img img { animation: dropIn .9s .2s cubic-bezier(.3,1.5,.5,1) both; }
        @keyframes dropIn { from { transform: translateY(-120px) rotate(-10deg); opacity: 0; } to { transform: none; opacity: 1; } }

        /* PUBLICIDAD: carrusel curvo */
        .ad-curve { position: relative; height: 440px; }
        .ad-stage { position: absolute; inset: 0; perspective: 1100px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
        .ad-c {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 230px;
            height: 330px;
            margin: -165px 0 0 -115px;
            padding: 0;
            border-radius: 14px;
            overflow: hidden;
            background: #14171d;
            border: 1px solid rgba(255,255,255,.2);
            box-shadow: 0 18px 42px rgba(0,0,0,.6);
            cursor: pointer;
            transition: transform .6s cubic-bezier(.3,.9,.3,1), opacity .5s, border-color .4s, box-shadow .4s;
            will-change: transform;
        }
        .ad-c img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .ad-c::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,9,13,.92), rgba(8,9,13,.2) 50%, transparent 70%); }
        .ad-l { position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 2; text-align: left; }
        .ad-l small { display: block; color: var(--gold); font-size: .56rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 5px; }
        .ad-l b { display: block; font-family: 'Playfair Display', serif; font-weight: 600; font-size: 1.05rem; line-height: 1.2; color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,.7); }
        .ad-c.active { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,187,138,.25), 0 0 40px rgba(176,42,104,.55); }
        .ad-nav { position: absolute; left: 14px; right: 14px; top: 50%; margin-top: -23px; display: flex; justify-content: space-between; pointer-events: none; z-index: 5; }
        .ad-stage { animation: nightGroup 14s ease-in-out infinite; }
        @keyframes nightGroup { 0%,100% { transform: translateX(0) translateY(0); } 25% { transform: translateX(-18px) translateY(-4px); } 50% { transform: translateX(0) translateY(3px); } 75% { transform: translateX(18px) translateY(-4px); } }
        .ad-stage .ad-c { transition: transform .65s cubic-bezier(.2,.8,.2,1), opacity .65s; }
        .ad-nav button { pointer-events: auto; width: 46px; height: 46px; border-radius: 50%; background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.4); color: #fff; transition: .3s; }
        .ad-nav button:hover { background: var(--wine); transform: scale(1.1); }
        .ad-hint { text-align: center; color: var(--muted); font-size: .72rem; letter-spacing: 2px; text-transform: uppercase; margin: 6px 0 0; }
        @media (max-width: 575px) { .type-image { height: 190px; } .ad-curve { height: 370px; } .ad-c { width: 170px; height: 250px; margin: -125px 0 0 -85px; } }

        /* ficha del anuncio: gira como una puerta al abrir */
        .am-content { background: var(--panel); border: 1px solid var(--border); color: var(--cream); border-radius: 0; overflow: hidden; }
        .modal.am-modal.fade .modal-dialog { transform: perspective(1300px) rotateY(-100deg) scale(.6); transform-origin: left center; opacity: 0; transition: transform .9s cubic-bezier(.2,.9,.3,1.1), opacity .5s; }
        .modal.am-modal.show .modal-dialog { transform: none; opacity: 1; }
        .am-img { position: relative; min-height: 340px; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0e1116; }
        .am-img .am-blur { position: absolute; inset: -20px; background: var(--img) center / cover no-repeat; filter: blur(26px) brightness(.5); }
        .am-img img { position: relative; max-width: 88%; max-height: 440px; object-fit: contain; box-shadow: 0 20px 50px rgba(0,0,0,.6); }
        .modal.am-modal.show .am-img img { animation: amIn 1s .3s cubic-bezier(.2,.9,.3,1.1) both; }
        @keyframes amIn { from { opacity: 0; transform: scale(1.35) rotate(4deg); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
        .modal.am-modal.show .am-text > * { animation: tileUp .7s both; }
        .modal.am-modal.show .am-text > *:nth-child(2) { animation-delay: .1s; }
        .modal.am-modal.show .am-text > *:nth-child(3) { animation-delay: .2s; }
        .modal.am-modal.show .am-text > *:nth-child(4) { animation-delay: .3s; }
        .modal.am-modal.show .am-text > *:nth-child(5) { animation-delay: .4s; }

        /* TIPOS DE BEBIDAS */

        .media-video { display: block; background: #1d2128; }

        .types-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem;
            text-align: center;
        }

        .type-card {
            background: var(--panel);
            border: 1px solid var(--border);
            height: 100%;
            overflow: hidden;
            transition: .35s;
        }

        .type-card:hover {
            transform: translateY(-6px);
            border-color: rgba(212,187,138,.55);
            box-shadow: 0 15px 35px rgba(0,0,0,.25);
        }

        .type-image { height: 235px; aspect-ratio: auto; position: relative; overflow: hidden; background: #0e1116; }
        .type-image .media-video { width: 100%; height: 100%; object-fit: cover; }

        .type-image img,

        .type-image video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: 1;
            transition: transform .6s;
        }

        .type-card:hover .type-image img,
        .type-card:hover .type-image video { transform: scale(1.03); }

        .type-image::after { display: none; }

        .type-image video.media-bg { display: none; }

        .type-image video.media-video {
            position: absolute;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            z-index: 1;
            object-fit: cover;
            object-position: center;
        }



        .type-icon {
            position: absolute;
            z-index: 2;
            bottom: 12px;
            left: 18px;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--wine);
            border: 1px solid rgba(232,213,174,.4);
            color: var(--gold-light);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .type-body { padding: 18px 20px 22px; }

        .type-body h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            color: var(--cream);
            margin-bottom: 8px;
        }

        .type-body p {
            color: var(--muted);
            font-size: .8rem;
            line-height: 1.7;
            margin: 0;
        }

        .extras-box {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 35px 30px;
            margin-top: 55px;
        }

        .extra-item { display: flex; gap: 15px; }

        .extra-item i { color: var(--gold); font-size: 1.5rem; margin-top: 3px; }

        .extra-item h5 {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

        .extra-item p {
            color: var(--muted);
            font-size: .8rem;
            line-height: 1.7;
            margin: 0;
        }

        /* CATALOG */

        .catalog-section {
            padding: 95px 0;
            background: #12151b;
            border-top: 1px solid var(--border);
        }

        .filter-box {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 25px;
            margin-bottom: 25px;
        }

        .filter-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 18px;
        }

        .filter-link {
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            padding: 9px 0;
            font-size: .85rem;
            transition: .2s;
        }

        .filter-link:hover, .filter-link.active { color: var(--gold); }

        .form-control-dark, .form-select-dark {
            background-color: #0e1116;
            border: 1px solid rgba(212,187,138,.25);
            border-radius: 2px;
            color: var(--cream);
            padding: 12px 14px;
            font-size: .84rem;
        }

        .form-control-dark:focus, .form-select-dark:focus {
            background-color: #0e1116;
            color: white;
            border-color: var(--gold);
            box-shadow: 0 0 0 .15rem rgba(212,187,138,.12);
        }

        .form-control-dark::placeholder { color: #7a7f8a; }

        .form-select-dark option { background: #14171d; color: var(--cream); }

        .product-card {
            background: var(--panel);
            border: 1px solid rgba(212,187,138,.13);
            height: 100%;
            transition: .35s;
            overflow: hidden;
        }

        .product-card:hover {
            transform: translateY(-6px);
            border-color: rgba(212,187,138,.55);
            box-shadow: 0 15px 35px rgba(0,0,0,.25);
        }

        .product-image {
            height: 255px;
            background: #1d2128;
            position: relative;
            overflow: hidden;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s;
        }

        .product-card:hover .product-image img { transform: scale(1.06); }

        .product-tag {
            position: absolute;
            top: 14px;
            left: 14px;
            background: var(--wine);
            color: white;
            padding: 6px 10px;
            font-size: .62rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .product-body { padding: 21px; }

        .product-category {
            color: var(--gold);
            font-size: .66rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.35rem;
            margin: 9px 0;
            color: var(--cream);
            line-height: 1.25;
        }

        .product-description {
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.6;
            min-height: 38px;
        }

        .product-meta {
            color: #aeb2bc;
            font-size: .72rem;
            line-height: 1.9;
            margin: 12px 0;
        }

        .product-meta i { color: var(--gold); width: 17px; }

        .product-bottom {
            border-top: 1px solid var(--border);
            padding-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .product-price {
            font-family: 'Playfair Display', serif;
            color: var(--gold-light);
            font-size: 1.45rem;
            font-weight: 700;
        }

        .btn-add {
            background: var(--wine);
            color: white;
            border: 1px solid var(--wine);
            border-radius: 2px;
            padding: 10px 13px;
            font-size: .72rem;
            font-weight: 700;
            transition: .25s;
        }

        .btn-add:hover { background: var(--wine-light); color: white; }

        .empty-state {
            text-align: center;
            padding: 75px 20px;
            background: var(--panel);
            border: 1px solid var(--border);
        }

        .empty-state i { font-size: 3rem; color: var(--gold); margin-bottom: 20px; }

        /* FEATURE */

        .feature-band {
            padding: 90px 0;
            background:
                linear-gradient(rgba(11,13,17,.86), rgba(11,13,17,.92)),
                url("https://images.unsplash.com/photo-1470337458703-46ad1756a187?auto=format&fit=crop&w=1800&q=85") center/cover;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            text-align: center;
        }

        .feature-band h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 5vw, 3.6rem);
        }

        /* FOOTER */

        footer {
            background: #0a0c10;
            padding: 65px 0 25px;
            border-top: 1px solid var(--border);
        }

        .footer-title {
            font-family: 'Playfair Display', serif;
            color: var(--gold-light);
            font-size: 1.2rem;
            margin-bottom: 18px;
        }

        .footer-text { color: var(--muted); font-size: .82rem; line-height: 1.9; }

        .footer-link {
            display: block;
            color: var(--muted);
            font-size: .82rem;
            margin-bottom: 11px;
        }

        .footer-link:hover { color: var(--gold); }

        .footer-bottom {
            border-top: 1px solid var(--border);
            margin-top: 40px;
            padding-top: 22px;
            color: #6f7480;
            font-size: .72rem;
        }

        /* CART */

        .offcanvas {
            background: #14171d;
            color: var(--cream);
            border-left: 1px solid var(--border);
        }

        .offcanvas-header { border-bottom: 1px solid var(--border); }

        .btn-close { filter: invert(1); }

        .cart-item {
            display: flex;
            gap: 14px;
            padding: 17px 0;
            border-bottom: 1px solid var(--border);
        }

        .cart-item-image {
            width: 75px;
            height: 90px;
            object-fit: cover;
            background: var(--panel-light);
        }

        .cart-item-info { flex: 1; }

        .cart-item-info h6 { font-family: 'Playfair Display', serif; font-size: 1rem; }

        .cart-muted { color: var(--muted); font-size: .75rem; }

        .cart-total {
            border-top: 1px solid var(--border);
            padding-top: 18px;
            margin-top: 20px;
        }

        .checkout-form {
            background: #1a1d24;
            border: 1px solid var(--border);
            padding: 20px;
            margin-top: 25px;
        }

        .checkout-form label {
            color: #d4cfc3;
            font-size: .75rem;
            margin-bottom: 7px;
        }

        /* AGE GATE: pantalla de bienvenida con el logo */

        body.gate-open { overflow: hidden; }

        .age-gate {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background:
                radial-gradient(ellipse at 82% 8%, rgba(96,106,128,.38), transparent 55%),
                radial-gradient(ellipse at 15% 95%, rgba(8,10,14,.95), transparent 60%),
                linear-gradient(135deg, #0c0e13, #1b1f27 52%, #0c0e13);
        }

        .age-gate::before {
            content: "";
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(115deg, rgba(255,255,255,.022) 0 1px, transparent 1px 5px);
            pointer-events: none;
        }

        .age-gate.hidden { display: none; }

        .age-card {
            position: relative;
            max-width: 520px;
            width: 100%;
            text-align: center;
        }

        .age-logo {
            width: 150px;
            height: auto;
            display: block;
            margin: 0 auto;
            animation: logoIn 1.4s cubic-bezier(.2,.8,.2,1) both, neonPulse 3.4s ease-in-out 1.4s infinite;
            transition: transform .9s ease, filter .9s ease;
        }

        @keyframes logoIn { from { opacity: 0; transform: translateY(24px) scale(.85); filter: blur(10px); } to { opacity: 1; transform: none; filter: none; } }

        @keyframes neonPulse {
            0%, 100% { filter: drop-shadow(0 0 8px rgba(176,42,104,.55)) drop-shadow(0 0 22px rgba(176,42,104,.30)); }
            50%      { filter: drop-shadow(0 0 14px rgba(200,50,120,.85)) drop-shadow(0 0 38px rgba(200,50,120,.50)); }
        }

        .age-name {
            font-family: 'Montserrat', 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: clamp(1.15rem, 4.4vw, 1.9rem);
            letter-spacing: .3em;
            color: var(--gold);
            margin-top: 26px;
            text-shadow: 0 2px 10px rgba(0,0,0,.6);
            animation: nameIn 1.6s .5s cubic-bezier(.2,.8,.2,1) both;
        }

        @keyframes nameIn { from { opacity: 0; letter-spacing: .6em; } to { opacity: 1; letter-spacing: .3em; } }

        .age-line {
            width: 90px;
            height: 1px;
            margin: 26px auto 22px;
            background: linear-gradient(90deg, transparent, var(--wine-light), transparent);
            animation: fadeUp 1s 1s both;
        }

        .age-card h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.6rem, 5vw, 2.1rem);
            margin: 0 0 12px;
            animation: fadeUp 1s 1.1s both;
        }

        .age-card p { color: var(--muted); font-size: .85rem; line-height: 1.8; animation: fadeUp 1s 1.2s both; }

        .age-actions { display: flex; gap: 12px; margin-top: 24px; animation: fadeUp 1s 1.3s both; }
        .age-actions button { flex: 1; }
        .age-actions .btn-gold { box-shadow: 0 0 24px rgba(176,42,104,.35); }
        .age-note { font-size: .68rem !important; margin-top: 22px; margin-bottom: 0; }

        @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

        /* al entrar: el logo se acerca y la pantalla se desvanece */
        .age-gate.leaving { animation: gateOut 1s ease forwards; pointer-events: none; }
        .age-gate.leaving .age-logo { animation: none; transform: scale(1.5); filter: drop-shadow(0 0 30px rgba(200,50,120,.9)); }
        @keyframes gateOut { 0% { opacity: 1; } 55% { opacity: 1; } 100% { opacity: 0; transform: scale(1.05); } }

        .brand-logo { height: 46px; width: auto; filter: drop-shadow(0 0 8px rgba(176,42,104,.6)); }

        .toast-container { z-index: 4000; }

        @media (max-width: 991px) {
            .hero-overlay { background: rgba(11,13,17,.72); }
            .hero { min-height: 560px; background-position: 62% center; }
            .nav-link-custom { margin: 0 5px; }
        }

        @media (max-width: 767px) {
            .hero { min-height: 570px; background-position: 65% center; }
            .hero-content { padding: 75px 0; }
            .collection-card { height: 330px; }
            .collections, .catalog-section { padding: 70px 0; }
            .product-image { height: 220px; }
            .benefit-item { justify-content: flex-start; padding: 8px 15px; }
            .age-logo { width: 120px; }
            .extras-box { padding: 28px 20px; }
        }

        @media (max-width: 420px) {
            .brand { font-size: 1.2rem; }
            .cart-button { padding: 9px 11px; font-size: .72rem; }
            .hero h1 { font-size: 3.1rem; }
        }
    </style>
</head>

<body>

<!-- VERIFICACIÓN DE EDAD -->
<div class="age-gate" id="ageGate">
    <div class="age-card" id="ageCard">
        <img class="age-logo" src="{% static 'images/logo-icon.png' %}" alt="Libido y Tentación" onerror="this.style.display='none'">

        <div class="age-name">LIBIDO Y TENTACIÓN</div>
        <div class="age-line"></div>

        <h2>¿Eres mayor de 18 años?</h2>

        <p>
            Este sitio contiene información sobre bebidas alcohólicas.
            Confirma que tienes la edad legal para entrar.
        </p>

        <div class="age-actions">
            <button class="btn-gold" id="confirmAge" type="button">Sí, entrar</button>
            <button class="btn-outline-gold" id="rejectAge" type="button">No</button>
        </div>

        <p class="age-note">Disfruta responsablemente. Prohibida la venta a menores de edad.</p>
    </div>
</div>

<!-- BARRA SUPERIOR -->
<div class="topbar">
    <i class="fa-solid fa-crown gold me-2"></i>
    UNA SELECCIÓN EXCLUSIVA PARA MOMENTOS ESPECIALES
</div>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center w-100">

            <a href="{% url 'home' %}" class="brand d-flex align-items-center gap-3">
                <img class="brand-logo" src="{% static 'images/logo-icon.png' %}" alt="" onerror="this.style.display='none'">
                <div>
                    LIBIDO <span>Y TENTACIÓN</span>
                    <span class="brand-subtitle">Selección premium</span>
                </div>
            </a>

            <div class="d-none d-lg-flex align-items-center">
                <a href="{% url 'home' %}" class="nav-link-custom">Inicio</a>
                <a href="#colecciones" class="nav-link-custom">Colecciones</a>
                <a href="#tienda" class="nav-link-custom">Tienda</a>
                <a href="#nosotros" class="nav-link-custom">Nosotros</a>
                <a href="{% url 'role_login' %}" class="nav-link-custom">
    <i class="fa-solid fa-user-shield"></i> Acceso al sistema
</a>
            </div>

            <button
                class="cart-button"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#cartCanvas"
                aria-controls="cartCanvas">
                <i class="fa-solid fa-bag-shopping"></i>
                <span class="d-none d-sm-inline">Mi carrito</span>
                <span class="cart-count" id="cartCount">0</span>
            </button>

        </div>
    </div>
</nav>

<!-- HERO -->
<header class="hero">

    <div class="hero-slides">
        <div class="hero-track">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video1.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio1.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/cb/08/2e/cb082eedfc22dcba74f2c03fcad68e64.jpg'" alt="Bebidas y licores Libido y Tentación" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video2.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio2.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/c0/6d/85/c06d85be00fb80b213e157a3e5a85a74.jpg'" alt="Bebidas y licores Libido y Tentación" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video3.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio3.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/1200x/57/43/1f/57431f46ccf8073cfdd5ad6b1edf1e78.jpg'" alt="Bebidas y licores Libido y Tentación" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video4.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio4.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/3b/0a/e5/3b0ae56494b99e542a80e44f60b45960.jpg'" alt="Bebidas y licores Libido y Tentación" referrerpolicy="no-referrer">
            <img src="{% static 'images/inicio5.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/f5/d3/7c/f5d37c945cffa47d4de73e6ab5bcceb1.jpg'" alt="Bebidas y licores Libido y Tentación" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video1.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio1.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/cb/08/2e/cb082eedfc22dcba74f2c03fcad68e64.jpg'" alt="" aria-hidden="true" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video2.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio2.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/c0/6d/85/c06d85be00fb80b213e157a3e5a85a74.jpg'" alt="" aria-hidden="true" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video3.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio3.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/1200x/57/43/1f/57431f46ccf8073cfdd5ad6b1edf1e78.jpg'" alt="" aria-hidden="true" referrerpolicy="no-referrer">
            <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="{% static 'videos/video4.mp4' %}" type="video/mp4"></video>
            <img src="{% static 'images/inicio4.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/3b/0a/e5/3b0ae56494b99e542a80e44f60b45960.jpg'" alt="" aria-hidden="true" referrerpolicy="no-referrer">
            <img src="{% static 'images/inicio5.jpg' %}" onerror="this.onerror=null;this.src='https://i.pinimg.com/736x/f5/d3/7c/f5d37c945cffa47d4de73e6ab5bcceb1.jpg'" alt="" aria-hidden="true" referrerpolicy="no-referrer">
        </div>
    </div>
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="hero-content">

            <div class="hero-kicker">
                <i class="fa-solid fa-star me-2"></i>
                El arte de elegir bien
            </div>

            <h1 class="hero-phrases" aria-label="Donde el deseo se sirve en copa. Una botella. Una noche. Una experiencia. Siente el deseo, disfruta el momento. Lo prohibido también tiene buen sabor.">
                <b class="phrase" style="--d:0s" aria-hidden="true">Donde el deseo se sirve en <em>copa.</em></b>
                <b class="phrase" style="--d:3s" aria-hidden="true">Una botella. Una noche. <em>Una experiencia.</em></b>
                <b class="phrase" style="--d:6s" aria-hidden="true">Siente el deseo, <em>disfruta el momento.</em></b>
                <b class="phrase" style="--d:9s" aria-hidden="true">Lo prohibido también tiene <em>buen sabor.</em></b>
            </h1>

            <p>
                Descubre una selección de bebidas y licores cuidadosamente
                elegidos para quienes aprecian la calidad, el carácter
                y los momentos extraordinarios.
            </p>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <a href="#colecciones" class="btn-gold">
                    Explorar colecciones
                    <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>

                <a href="#tienda" class="btn-outline-gold">
                    Visitar la tienda
                </a>
            </div>

        </div>
    </div>
</header>

<!-- PÁGINAS DE COLECCIÓN -->
<section class="col-page" id="colPage" hidden></section>

<!-- BENEFICIOS -->
<section class="benefits">
    <div class="container">
        <div class="row g-3">

            <div class="col-md-4">
                <div class="benefit-item">
                    <i class="fa-solid fa-gem"></i>
                    <span>Selección de calidad</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit-item">
                    <i class="fa-solid fa-box"></i>
                    <span>Atención personalizada</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit-item">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Compra segura</span>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- COLECCIONES -->
<section class="collections" id="colecciones">
    <div class="container">

        <div class="text-center mb-5">
            <div class="section-label">Descubre nuestra selección</div>
            <h2 class="section-title mt-3">Colecciones destacadas</h2>
            <p class="text-secondary mt-3">
                Encuentra la bebida ideal para cada ocasión.
            </p>
            <div class="quick-links mt-4">
                <a href="#vinos"><i class="fa-solid fa-wine-bottle"></i>Vinos</a>
                <a href="#licoreria"><i class="fa-solid fa-whiskey-glass"></i>Licores</a>
                <a href="#licores"><i class="fa-solid fa-martini-glass-citrus"></i>Licores y cremas</a>
                <a href="#especiales"><i class="fa-solid fa-champagne-glasses"></i>Especiales</a>
                <a href="#destilados"><i class="fa-solid fa-fire"></i>Destilados</a>
                <a href="#cervezas"><i class="fa-solid fa-beer-mug-empty"></i>Cervezas</a>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="collection-card">
                    <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=900&q=85" aria-label="Colección de vinos">
                            <source src="{% static 'videos/vino.mp4' %}" type="video/mp4">
                        </video>
                    <div class="collection-info">
                        <small>Elegancia y tradición</small>
                        <h3>Vinos</h3>
                        <a href="#vinos">Explorar colección <i class="fa-solid fa-arrow-right ms-2"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="collection-card">
                    <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=1170&auto=format&fit=crop" aria-label="Colección de licores">
                            <source src="{% static 'videos/licores.mp4' %}" type="video/mp4">
                        </video>
                    <div class="collection-info">
                        <small>Carácter y personalidad</small>
                        <h3>Licores</h3>
                        <a href="#licoreria">Explorar colección <i class="fa-solid fa-arrow-right ms-2"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="collection-card">
                    <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1650060190263-db5bf1ccfc12?q=80&w=1170&auto=format&fit=crop" aria-label="Bebidas especiales">
                            <source src="{% static 'videos/especiales.mp4' %}" type="video/mp4">
                        </video>
                    <div class="collection-info">
                        <small>Momentos especiales</small>
                        <h3>Especiales</h3>
                        <a href="#especiales">Explorar colección <i class="fa-solid fa-arrow-right ms-2"></i></a>
                    </div>
                </div>
            </div>

        </div>

        <!-- TIPOS DE BEBIDAS DISPONIBLES -->
        <div class="text-center mt-5 pt-4 mb-4">
            <div class="section-label">Variedad para todos los gustos</div>
            <h3 class="types-title mt-3">Tipos de bebidas disponibles</h3>
        </div>

        <div class="types-wheel">
        <div class="types-ring">

            <div class="ring-item" style="--k:0">
                <div class="type-card">
                    <div class="type-image">
                        <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=800&auto=format&fit=crop" aria-label="Destilados y aguardientes">
                            <source src="{% static 'videos/bebidas_destiladas.mp4' %}" type="video/mp4">
                        </video>
                        <span class="type-icon"><i class="fa-solid fa-whiskey-glass"></i></span>
                    </div>
                    <div class="type-body">
                        <h4>Destilados y aguardientes</h4>
                        <p>Ron, whisky, pisco (muy tradicional en Perú), tequila, vodka, ginebra (gin) y brandy.</p>
                        <a href="#destilados" class="type-link stretched-link">Ver bebidas <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

            <div class="ring-item" style="--k:1">
                <div class="type-card">
                    <div class="type-image">
                        <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=800&q=80" aria-label="Vinos y espumantes">
                            <source src="{% static 'videos/vino.mp4' %}" type="video/mp4">
                        </video>
                        <span class="type-icon"><i class="fa-solid fa-wine-glass"></i></span>
                    </div>
                    <div class="type-body">
                        <h4>Vinos y espumantes</h4>
                        <p>Vino tinto, blanco, rosado, champagne y prosecco de diversas marcas y gamas de precios.</p>
                        <a href="#vinos-espumantes" class="type-link stretched-link">Ver vinos y espumantes <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

            <div class="ring-item" style="--k:2">
                <div class="type-card">
                    <div class="type-image">
                        <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1470337458703-46ad1756a187?auto=format&fit=crop&w=800&q=80" aria-label="Cervezas">
                            <source src="{% static 'videos/cerveza.mp4' %}?v=4" type="video/mp4">
                        </video>
                        <span class="type-icon"><i class="fa-solid fa-beer-mug-empty"></i></span>
                    </div>
                    <div class="type-body">
                        <h4>Cervezas</h4>
                        <p>Nacionales e importadas, en latas, botellas personales, litros o packs.</p>
                        <a href="#cervezas" class="type-link stretched-link">Ver cervezas <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

            <div class="ring-item" style="--k:3">
                <div class="type-card">
                    <div class="type-image">
                        <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://images.unsplash.com/photo-1650060190263-db5bf1ccfc12?q=80&w=800&auto=format&fit=crop" aria-label="Licores y cremas">
                            <source src="{% static 'videos/licores_y_cremas.mp4' %}" type="video/mp4">
                        </video>
                        <span class="type-icon"><i class="fa-solid fa-martini-glass-citrus"></i></span>
                    </div>
                    <div class="type-body">
                        <h4>Licores y cremas</h4>
                        <p>Aperitivos (como Aperol o Campari), licores de hierbas, licores de café y cremas de whisky.</p>
                        <a href="#licores" class="type-link stretched-link">Ver licores <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

            <div class="ring-item" style="--k:4">
                <div class="type-card">
                    <div class="type-image">
                        <video class="media-video" autoplay muted loop playsinline preload="metadata" poster="https://i.pinimg.com/1200x/13/13/9d/13139d1faa28b4799e2433f7942235d4.jpg" aria-label="Licores regionales">
                            <source src="{% static 'videos/aguardientes.mp4' %}" type="video/mp4">
                        </video>
                        <span class="type-icon"><i class="fa-solid fa-earth-americas"></i></span>
                    </div>
                    <div class="type-body">
                        <h4>Licores regionales</h4>
                        <p>Pisco, cañazo y macerados peruanos con identidad propia.</p>
                        <a href="#regionales" class="type-link stretched-link">Ver regionales <i class="fa-solid fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>

        </div>
        </div>

        <!-- COMPLEMENTOS Y EXTRAS -->
        <div class="extras-box">
            <div class="text-center mb-4">
                <div class="section-label">Para completar tu pedido</div>
                <h3 class="types-title mt-2">Complementos y extras</h3>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="extra-item">
                        <i class="fa-solid fa-bottle-water"></i>
                        <div>
                            <h5>Bebidas sin alcohol</h5>
                            <p>Gaseosas, agua embotellada, bebidas energizantes (como Gatorade o Red Bull) y agua tónica.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="extra-item">
                        <i class="fa-solid fa-lemon"></i>
                        <div>
                            <h5>Insumos para coctelería</h5>
                            <p>Hielo en bolsa, limones, jarabes, bitter y vasos descartables.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="extra-item">
                        <i class="fa-solid fa-cookie-bite"></i>
                        <div>
                            <h5>Aperitivos</h5>
                            <p>Snacks como papas fritas, maníes y piqueos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- PUBLICIDAD -->
<section class="promo">
    <div class="container text-center mb-4">
        <div class="section-label">Inspírate</div>
        <h2 class="section-title mt-3">Noches que se recuerdan</h2>
    </div>
    <div class="ad-curve">
        <div class="ad-stage" id="adStage"></div>
        <div class="ad-nav">
            <button type="button" id="adPrev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" id="adNext" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </div>
    <p class="ad-hint">Toca una imagen para ver toda la información</p>
</section>

<!-- TIENDA -->
<section class="store" id="tienda">
    <div class="container">

        <div class="text-center mb-5">
            <div class="section-label">Nuestro local</div>
            <h2 class="section-title mt-3">Visítanos, la noche te espera</h2>
            <p class="text-secondary mt-3 mx-auto" style="max-width:620px;">
                Un espacio pensado para disfrutar: buena música, luces tenues y la mejor selección de licores.
            </p>
        </div>

        <div class="store-gallery">
            <figure class="sg sg-a"><img src="https://images.unsplash.com/photo-1760982192590-de2b005bb4d5?auto=format&fit=crop&w=1200&q=80" alt="La barra del local" loading="lazy"><figcaption><small>Ambiente</small><b>La barra</b></figcaption></figure>
            <figure class="sg sg-b"><img src="https://images.unsplash.com/photo-1740247374238-af6f14719373?auto=format&fit=crop&w=900&q=80" alt="Noches con neón" loading="lazy"><figcaption><small>Noches</small><b>Luces y neón</b></figcaption></figure>
            <figure class="sg sg-c"><img src="https://images.unsplash.com/photo-1570560258879-af7f8e1447ac?auto=format&fit=crop&w=900&q=80" alt="Terraza lounge" loading="lazy"><figcaption><small>Lounge</small><b>Terraza</b></figcaption></figure>
            <figure class="sg sg-d"><img src="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1400&q=80" alt="Selección de botellas" loading="lazy"><figcaption><small>Selección</small><b>Botellas para cada ocasión</b></figcaption></figure>
        </div>

        <div class="row g-4 mt-4 store-info">
            <div class="col-md-6 col-lg-3">
                <div class="si-card"><i class="fa-solid fa-location-dot"></i><h5>Dirección</h5><p data-t="direccion"></p><p class="si-sub" data-t="ciudad"></p></div>
            </div>
            <div class="col-md-6 col-lg-3">
