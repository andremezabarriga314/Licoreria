                {i: "fa-champagne-glasses", t: "Celebrar", x: "Champagne y espumantes para brindis inolvidables."},
                {i: "fa-gift", t: "Regalar", x: "Botellas premium listas para sorprender."},
                {i: "fa-crown", t: "Coleccionar", x: "Etiquetas selectas para paladares exigentes."}
            ],
            items: ESPECIALES
        },
        vinos_espumantes: {
            title: "Vinos y espumantes", kicker: "Brindis con otra energía", icon: "fa-champagne-glasses", layout: "stack",
            tag: "Burbujas, blancos y rosados para cambiar el ritmo.",
            desc: "Una selección diferente a la colección Vinos, enfocada en prosecco, brut, rosados y blancos frescos.",
            bg: "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1800&q=80",
            filters: [["todos", "Todos"], ["espumante", "Espumantes"], ["blanco", "Blancos"], ["rosado", "Rosados"]],
            info: [
                {i: "fa-champagne-glasses", t: "Burbujas", x: "Prosecco, brut y espumantes para celebrar."},
                {i: "fa-wine-glass", t: "Blancos", x: "Frescos y ligeros para aperitivos y pescados."},
                {i: "fa-heart", t: "Rosados", x: "Frutales y elegantes para noches relajadas."}
            ],
            items: VINOS_ESPUMANTES
        },
        regionales: {
            title: "Licores regionales", kicker: "Sabores del Perú", icon: "fa-earth-americas", layout: "spot",
            tag: "Tradición peruana servida con una estética nueva.",
            desc: "Piscos, cañazos y macerados con identidad peruana. Nada de fotos de bares: aquí mandan las bebidas.",
            bg: "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1800&q=80",
            filters: [["todos", "Todos"], ["pisco", "Piscos"], ["cañazo", "Cañazo"], ["macerado", "Macerados"]],
            info: [
                {i: "fa-bottle-droplet", t: "Pisco", x: "Quebranta, acholado y mosto verde."},
                {i: "fa-mountain-sun", t: "Tradición", x: "Destilados que conectan con distintas regiones del Perú."},
                {i: "fa-wand-magic-sparkles", t: "Macerados", x: "Frutas y café para una experiencia diferente."}
            ],
            items: REGIONALES
        },
        destilados: {
            title: "Destilados", kicker: "Destilados y aguardientes", icon: "fa-whiskey-glass", layout: "roulette",
            tag: "Gira la ruleta y elige tu próximo brindis.",
            desc: "Ron, whisky, pisco, tequila, vodka, ginebra y brandy. Desliza o toca una botella para ver su información.",
            bg: "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=1800&auto=format&fit=crop",
            filters: [],
            info: [
                {i: "fa-fire", t: "Aguardientes", x: "Pisco y otros destilados de uva y caña, tradición del Perú."},
                {i: "fa-whiskey-glass", t: "Whisky y brandy", x: "Envejecidos, para disfrutar despacio."},
                {i: "fa-martini-glass-citrus", t: "Para mezclar", x: "Ron, vodka, ginebra y tequila: la base de tus cócteles."}
            ],
            items: DESTILADOS
        },
        cervezas: {
            title: "Cervezas", kicker: "Bien fría, bien servida", icon: "fa-beer-mug-empty", layout: "spot",
            tag: "Espuma, burbujas y buena compañía.",
            desc: "Nacionales e importadas, en latas, botellas personales, litros o packs. Elige una y brinda.",
            bg: "https://images.unsplash.com/photo-1470337458703-46ad1756a187?auto=format&fit=crop&w=1800&q=80",
            filters: [],
            info: [
                {i: "fa-snowflake", t: "Bien fría", x: "Sírvela helada y con espuma cremosa."},
                {i: "fa-boxes-stacked", t: "Packs y litros", x: "Latas, botellas personales, litros o packs para compartir."},
                {i: "fa-earth-americas", t: "Nacionales e importadas", x: "Las de siempre y las que quieres probar."}
            ],
            items: CERVEZAS
        }
    };

    const KEYS = Object.keys(COL);
    const page = document.getElementById("colPage");
    const modalEl = document.getElementById("detailModal");
    if (!page || !modalEl) return;

    const homeEls = Array.from(document.querySelectorAll("header.hero, section.benefits, section.collections, section.promo, section.store, section.feature-band"));
    let current = null, filter = "todos";

    const money = function (p) { return p == null ? "Consultar" : "S/ " + p.toFixed(2); };
    const src = function (w) {
        const raw = IMAGENES[w.n] || w.img;
        return !raw ? null : (/^https?:/.test(raw) ? raw : BASE + raw + "&width=600");
    };
    const media = function (w, icon) {
        const u = src(w);
        return u ? '<img src="' + u + '" alt="' + w.n + '" data-ph="' + icon + '" data-u="' + u + '" referrerpolicy="no-referrer">'
                 : '<i class="fa-solid ' + icon + ' ph"></i>';
    };

    // si una imagen no carga: primero se reintenta por un servidor de imágenes; si tampoco, se muestra el ícono
    document.addEventListener("error", function (e) {
        const t = e.target;
        if (t && t.tagName === "IMG" && t.dataset && t.dataset.px !== undefined) {
            if (!t.dataset.retry) {
                t.dataset.retry = "1";
                t.src = "https://images.weserv.nl/?url=" + encodeURIComponent((t.getAttribute("src") || "").replace(/^https?:\/\//, "")) + "&w=700&output=jpg";
            } else {
                t.style.visibility = "hidden";
            }
            return;
        }
        if (!t || t.tagName !== "IMG" || !t.dataset || !t.dataset.ph) return;
        const u = t.dataset.u || "";
        if (!t.dataset.retry && /^https?:/.test(u)) {
            t.dataset.retry = "1";
            t.src = "https://images.weserv.nl/?url=" + encodeURIComponent(u.replace(/^https?:\/\//, "")) + "&w=700&output=jpg";
            return;
        }
        t.outerHTML = '<i class="fa-solid ' + t.dataset.ph + ' ph"></i>';
    }, true);

    // ---------- DATOS DE LA TIENDA (edítalos aquí) ----------
    const TIENDA = {
        whatsapp: "51999999999",
        whatsappVisible: "+51 999 999 999",
        yape: "999 999 999",
        plin: "999 999 999",
        titular: "Libido y Tentación",
        direccion: "Escribe aquí la dirección de tu local",
        ciudad: "Tu ciudad, Perú",
        horario: "Todos los días · 12:00 m. – 2:00 a. m.",
        delivery: "Delivery y recojo en tienda"
    };

    document.querySelectorAll("[data-t]").forEach(function (el) { el.textContent = TIENDA[el.dataset.t] || ""; });
    document.querySelectorAll("[data-wa]").forEach(function (a) {
        a.href = "https://wa.me/" + TIENDA.whatsapp;
        a.target = "_blank";
        a.rel = "noopener";
    });
    // fotos de la tienda: aparecen al hacer scroll
    (function () {
        const figs = document.querySelectorAll(".sg");
        if (!("IntersectionObserver" in window)) { figs.forEach(function (f) { f.classList.add("in"); }); return; }
        const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    const k = Array.prototype.indexOf.call(figs, e.target);
                    setTimeout(function () { e.target.classList.add("in"); }, k * 140);
                    io.unobserve(e.target);
                }
            });
        }, {threshold: 0.15});
        figs.forEach(function (f) { io.observe(f); });
    })();

    // ---------- CARRITO ----------
    const CART_KEY = "libido_cart_v1";
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem(CART_KEY) || "[]"); if (!Array.isArray(cart)) cart = []; } catch (err) { cart = []; }

    const fmt = function (n) { return "S/ " + n.toFixed(2); };
    function cartCount() { return cart.reduce(function (a, c) { return a + c.qty; }, 0); }
    function cartTotal() { return cart.reduce(function (a, c) { return a + c.qty * c.price; }, 0); }

    function updateBadge(bump) {
        const b = document.getElementById("cartCount");
        if (!b) return;
        b.textContent = cartCount();
        if (bump) { b.classList.remove("bump"); void b.offsetWidth; b.classList.add("bump"); }
    }

    function saveCart() {
        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (err) {}
        updateBadge();
    }

    let toastT = null;
    function toast(msg) {
        const t = document.getElementById("cartToast");
        if (!t) return;
        document.getElementById("ctText").textContent = msg;
        t.classList.add("show");
        clearTimeout(toastT);
        toastT = setTimeout(function () { t.classList.remove("show"); }, 3200);
    }

    function flyToCart(from) {
        const target = document.querySelector(".cart-button");
        if (!from || !target || !from.getBoundingClientRect) return;
        const d = document.createElement("div");
        if (!d.animate) return;
        const a = from.getBoundingClientRect(), b = target.getBoundingClientRect();
        d.className = "fly-dot";
        d.style.left = (a.left + a.width / 2 - 9) + "px";
        d.style.top = (a.top + a.height / 2 - 9) + "px";
        document.body.appendChild(d);
        const an = d.animate([
            {transform: "translate(0,0) scale(1)", opacity: 1},
            {transform: "translate(" + (b.left + b.width / 2 - a.left - a.width / 2) + "px," + (b.top + b.height / 2 - a.top - a.height / 2) + "px) scale(.3)", opacity: 0.2}
        ], {duration: 750, easing: "cubic-bezier(.5,0,.3,1)"});
        an.onfinish = function () { d.remove(); };
    }

    function itemImage(key, i) {
        const w = COL[key].items[i];
        return key === "licores" ? obImg(w, i) : src(w);
    }

    function addToCart(key, i, qty, fromEl) {
        const w = COL[key].items[i];
        if (w.p == null) { toast("Este producto no está disponible para compra online todavía."); return; }
        qty = Math.max(1, qty || 1);
        const id = key + ":" + i;
        const f = cart.find(function (c) { return c.id === id; });
        if (f) f.qty = Math.min(99, f.qty + qty);
        else cart.push({id: id, n: w.n, price: w.p, qty: qty, img: itemImage(key, i) || "", icon: COL[key].icon});
        saveCart();
        updateBadge(true);
        renderCart();
        toast("Agregado: " + w.n + (qty > 1 ? " × " + qty : ""));
        flyToCart(fromEl);
    }

    function renderCart() {
        const body = document.getElementById("cartBody");
        if (!body) return;
        if (!cart.length) {
            body.innerHTML = '<div class="empty-state mt-3"><i class="fa-solid fa-bag-shopping"></i><h4 class="serif">Tu carrito está vacío</h4>' +
                '<p class="text-secondary">Todavía no has agregado productos a tu selección.</p>' +
                '<button type="button" class="btn-gold mt-3" data-cart="explore">Explorar colecciones</button></div>';
            return;
        }
        body.innerHTML = cart.map(function (c) {
            return '<div class="cart-item" data-id="' + c.id + '">' +
                '<div class="ci-thumb">' + (c.img ? '<img src="' + c.img + '" alt="" referrerpolicy="no-referrer" data-ph="' + c.icon + '" data-u="' + c.img + '">' : '<i class="fa-solid ' + c.icon + '"></i>') + '</div>' +
                '<div class="cart-item-info"><h6 class="ci-name">' + c.n + '</h6><div class="ci-price">' + fmt(c.price) + ' c/u</div>' +
                '<div class="d-flex align-items-center gap-3 mt-2 flex-wrap">' +
                '<div class="qty"><button type="button" data-cart="minus" aria-label="Menos">−</button><span>' + c.qty + '</span><button type="button" data-cart="plus" aria-label="Más">+</button></div>' +
                '<button type="button" class="ci-del" data-cart="del" aria-label="Quitar"><i class="fa-solid fa-trash"></i></button></div>' +
                '<div class="cart-muted mt-2">Subtotal: <b class="gold">' + fmt(c.price * c.qty) + '</b></div></div></div>';
        }).join("") +
            '<div class="cart-total"><div class="d-flex justify-content-between align-items-center"><span class="text-secondary">Total de compra</span><strong class="product-price">' + fmt(cartTotal()) + '</strong></div>' +
            '<button type="button" class="btn-gold w-100 mt-3" data-cart="checkout">Proceder a comprar <i class="fa-solid fa-arrow-right ms-2"></i></button>' +
            '<button type="button" class="btn btn-outline-danger btn-sm w-100 mt-2" data-cart="clear"><i class="fa-solid fa-trash me-2"></i>Vaciar carrito</button></div>';
    }

    function closeCart() {
        const el = document.getElementById("cartCanvas");
        const inst = el && bootstrap.Offcanvas.getInstance(el);
        if (inst) inst.hide();
    }

    const cartBody = document.getElementById("cartBody");
    if (cartBody) cartBody.addEventListener("click", function (e) {
        const b = e.target.closest("[data-cart]");
        if (!b) return;
        const act = b.dataset.cart, row = b.closest(".cart-item"), id = row && row.dataset.id;
        const it = id && cart.find(function (c) { return c.id === id; });
        if (act === "plus" && it) it.qty = Math.min(99, it.qty + 1);
        else if (act === "minus" && it) it.qty = Math.max(1, it.qty - 1);
        else if (act === "del") cart = cart.filter(function (c) { return c.id !== id; });
        else if (act === "clear") cart = [];
        else if (act === "explore") { closeCart(); location.hash = "colecciones"; return; }
        else if (act === "checkout") { openCheckout(); return; }
        saveCart();
        renderCart();
    });

    const cartCanvas = document.getElementById("cartCanvas");
    if (cartCanvas) cartCanvas.addEventListener("show.bs.offcanvas", renderCart);
    const ctOpen = document.getElementById("ctOpen");
    if (ctOpen) ctOpen.addEventListener("click", function () {
        document.getElementById("cartToast").classList.remove("show");
        bootstrap.Offcanvas.getOrCreateInstance(cartCanvas).show();
    });

    // ---------- FINALIZAR COMPRA ----------
    const coModalEl = document.getElementById("checkoutModal");
    const coForm = document.getElementById("coForm");

    function fillSummary() {
        document.getElementById("coItems").innerHTML = cart.map(function (c) {
            return '<li><span>' + c.qty + ' × ' + c.n + '</span><b>' + fmt(c.qty * c.price) + '</b></li>';
        }).join("");
        document.getElementById("coSub").textContent = fmt(cartTotal());
        document.getElementById("coTotal").textContent = fmt(cartTotal());
    }

    function toggleDelivery() {
        const deliv = coForm.elements.entrega.value === "Delivery";
        coForm.querySelectorAll(".co-deliv").forEach(function (el) { el.hidden = !deliv; });
    }

    function payDetail() {
        const v = coForm.elements.pago.value, box = document.getElementById("payDetail"), tot = fmt(cartTotal());
        if (v === "Yape" || v === "Plin") {
            const num = v === "Yape" ? TIENDA.yape : TIENDA.plin;
            box.innerHTML = '<div class="pd">Envía <b>' + tot + '</b> por <b>' + v + '</b> al número<br><span class="pd-num">' + num + '</span><br>a nombre de <b>' + TIENDA.titular + '</b>. El pedido quedará registrado y será verificado por nuestro equipo.</div>';
        } else if (v === "Tarjeta de débito") {
            box.innerHTML = '<div class="pd">Pagas <b>' + tot + '</b> con tu <b>tarjeta de débito</b> al recibir tu pedido (llevamos POS) o en la tienda. Aquí no necesitas escribir datos de tarjeta.</div>';
        } else {
            box.innerHTML = "";
        }
    }

    function openCheckout() {
        if (!cart.length) return;
        closeCart();
        coForm.reset();
        coForm.querySelectorAll(".invalid").forEach(function (x) { x.classList.remove("invalid"); });
        document.getElementById("coPayErr").classList.remove("show");
        fillSummary();
        toggleDelivery();
        payDetail();
        setTimeout(function () { bootstrap.Modal.getOrCreateInstance(coModalEl).show(); }, 350);
    }

    coForm.addEventListener("change", function (e) {
        if (e.target.name === "entrega") toggleDelivery();
        if (e.target.name === "pago") { payDetail(); document.getElementById("coPayErr").classList.remove("show"); }
    });
    coForm.addEventListener("input", function (e) { if (e.target.classList) e.target.classList.remove("invalid"); });

    coForm.addEventListener("submit", function (e) {
        e.preventDefault();
        const f = coForm.elements;
        const v = function (n) { return f[n].value.trim(); };
        let ok = true;
        function bad(el, cond) { el.classList.toggle("invalid", cond); if (cond) ok = false; }
        const deliv = f.entrega.value === "Delivery";
        bad(f.nombre, v("nombre").length < 3);
        bad(f.celular, !/^\+?\d{9,13}$/.test(v("celular").replace(/[\s-]/g, "")));
        bad(f.direccion, deliv && v("direccion").length < 5);
        bad(f.distrito, deliv && v("distrito").length < 3);
        const pago = f.pago.value;
        document.getElementById("coPayErr").classList.toggle("show", !pago);
        if (!pago) ok = false;
        if (!ok) { const first = coForm.querySelector(".invalid"); if (first) first.focus(); return; }
        placeOrder({nombre: v("nombre"), celular: v("celular"), entrega: f.entrega.value, direccion: v("direccion"), distrito: v("distrito"), referencia: v("referencia"), pago: pago});
    });

    async function placeOrder(d) {
        const payload = {
            nombre: d.nombre,
            celular: d.celular,
            entrega: d.entrega,
            direccion: d.direccion,
            distrito: d.distrito,
            referencia: d.referencia,
            pago: d.pago,
            items: cart.map(function (c) {
                return {
                    nombre: c.n,
                    precio: Number(c.price),
                    cantidad: Number(c.qty)
                };
            })
        };

        const csrf = coForm.querySelector('[name="csrfmiddlewaretoken"]');
        const btn = document.getElementById("coSubmit");

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Registrando pedido...';
        }

        try {
            const response = await fetch("{% url 'procesar' %}", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRFToken": csrf ? csrf.value : ""
                },
                credentials: "same-origin",
                body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (!response.ok || !result.ok) {
                throw new Error(result.mensaje || result.error || "No se pudo registrar el pedido.");
            }

            const order = {
                num: "LT-" + String(result.id).padStart(5, "0"),
                name: result.nombre,
                pago: d.pago,
                total: Number(result.total),
                items: result.items.map(function (i) {
                    return {
                        n: i.nombre,
                        q: i.cantidad,
                        p: Number(i.precio)
                    };
                })
            };

            const inst = bootstrap.Modal.getInstance(coModalEl);
            if (inst) inst.hide();

            showSuccess(order);
            cart = [];
            saveCart();
            renderCart();

        } catch (err) {
            toast(err.message || "No se pudo registrar el pedido.");
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = 'Confirmar pedido <i class="fa-solid fa-arrow-right ms-2"></i>';
            }
        }
    }

    function confetti() {
        const box = document.getElementById("odConfetti");
        const cols = ["#d4bb8a", "#e8d5ae", "#b02a68", "#8a1c4c", "#ffffff", "#f5b638"];
        let h = "";
        for (let i = 0; i < 90; i++) {
            const w = 6 + Math.random() * 8;
            h += '<i style="--x:' + (Math.random() * 100).toFixed(1) + '%;--w:' + w.toFixed(0) + 'px;--h:' + (w * (Math.random() * 1.6 + 0.6)).toFixed(0) +
                 'px;--c:' + cols[i % cols.length] + ';--t:' + (2.6 + Math.random() * 2.4).toFixed(2) + 's;--d:' + (1.2 + Math.random() * 1.6).toFixed(2) +
                 's;--dx:' + ((Math.random() * 240) - 120).toFixed(0) + 'px;--r:' + ((Math.random() * 900) - 450).toFixed(0) + 'deg"></i>';
        }
        box.innerHTML = h;
    }

    function showSuccess(order) {
        const od = document.getElementById("orderDone");
        document.getElementById("odName").textContent = order.name.split(" ")[0];
        document.getElementById("odNum").textContent = order.num;
        document.getElementById("odItems").innerHTML = order.items.map(function (i, n) {
            return '<li style="--n:' + n + '"><span>' + i.q + ' × ' + i.n + '</span><b>' + fmt(i.p * i.q) + '</b></li>';
        }).join("");
        document.getElementById("odTotal").textContent = fmt(order.total);
        document.getElementById("odPay").textContent = order.pago === "Tarjeta de débito"
            ? "Pagarás con tarjeta de débito (POS) al recibir tu pedido."
            : "Tu pedido quedó registrado y será verificado por nuestro equipo.";
        const seal = document.getElementById("odSeal");
        const old = seal.querySelector(".od-rays");
        if (old) old.remove();
        let rays = "";
        for (let k = 0; k < 12; k++) rays += '<i style="--a:' + (k * 30) + 'deg"></i>';
        seal.insertAdjacentHTML("beforeend", '<span class="od-rays">' + rays + '</span>');
        confetti();
        od.hidden = false;
        document.body.style.overflow = "hidden";
    }

    const odClose = document.getElementById("odClose");
    if (odClose) odClose.addEventListener("click", function () {
        document.getElementById("orderDone").hidden = true;
        document.body.style.overflow = "";
        location.hash = "colecciones";
    });

    // cantidad en la ficha del producto
    let dmItem = {key: null, i: 0, qty: 1};
    function dmRefresh() {
        if (!dmItem.key) return;
        const w = COL[dmItem.key].items[dmItem.i];
        document.getElementById("dmQty").textContent = dmItem.qty;
        document.getElementById("dmAdd").innerHTML = w.p == null
            ? '<i class="fa-solid fa-circle-info me-2"></i>No disponible online'
            : '<i class="fa-solid fa-bag-shopping me-2"></i>Agregar · ' + fmt(w.p * dmItem.qty);
    }
    document.getElementById("dmMinus").addEventListener("click", function () { dmItem.qty = Math.max(1, dmItem.qty - 1); dmRefresh(); });
    document.getElementById("dmPlus").addEventListener("click", function () { dmItem.qty = Math.min(99, dmItem.qty + 1); dmRefresh(); });
    document.getElementById("dmAdd").addEventListener("click", function () {
        addToCart(dmItem.key, dmItem.i, dmItem.qty, this);
        const inst = bootstrap.Modal.getInstance(modalEl);
        if (inst) inst.hide();
    });

    updateBadge();
    renderCart();

    function cardHTML(w, i, k, key, icon, layout) {
        return '<button type="button" class="p-card pc-' + key + (layout === "roulette" ? " rl-card" : "") + '" style="--i:' + k + '" data-i="' + i + '" data-k="' + k + '">' +
               '<div class="p-img"><span class="p-badge">' + w.t + '</span>' + media(w, icon) + '</div>' +
               '<div class="p-info"><h4>' + w.n + '</h4><small>' + (w.pais || "&nbsp;") + '</small>' +
               '<div class="p-price' + (w.p == null ? ' ask' : '') + '">' + money(w.p) + '</div>' +
               '<span class="p-more">Ver información <i class="fa-solid fa-arrow-right ms-1"></i></span></div></button>';
    }

    // ---------- ruleta (Destilados) ----------
    let rlActive = 0, rlTimer = null, rlHover = false, rlIgnoreUntil = 0, swipeX = null;

    function rlCards() { return document.querySelectorAll("#cpGrid .rl-card"); }

    function rlBgUpdate() {
        const bg = document.getElementById("rlBg");
        const card = rlCards()[rlActive];
        if (!bg || !card || !current) return;
        const u = src(COL[current].items[+card.dataset.i]);
        bg.classList.add("swap");
        setTimeout(function () {
            bg.style.backgroundImage = u ? 'url("' + u + '")' : "none";
            bg.classList.remove("swap");
        }, 350);
    }

    function rlLayout() {
        const grid = document.getElementById("cpGrid");
        const cards = rlCards();
        const n = cards.length;
        if (!grid || !n) return;
        const gap = Math.max(90, Math.min(200, grid.clientWidth * 0.2));
        cards.forEach(function (el, i) {
            let d = i - rlActive;
            if (d > n / 2) d -= n;
            if (d < -n / 2) d += n;
            const a = Math.abs(d);
            el.style.transform = "translateX(" + (d * gap) + "px) translateZ(" + (-a * 150) + "px) rotateY(" + (d * -26) + "deg) scale(" + (1 - Math.min(a, 3) * 0.1) + ")";
            el.style.zIndex = String(100 - Math.round(a * 10));
            el.style.opacity = a === 0 ? "1" : (a === 1 ? "0.6" : (a === 2 ? "0.3" : "0"));
            el.style.filter = a === 0 ? "none" : "blur(" + (Math.min(a, 3) * 1.5) + "px) brightness(.6)";
            el.style.pointerEvents = a <= 2 ? "auto" : "none";
            el.classList.toggle("active", a === 0);
        });
    }

    function rlGo(k) {
        const n = rlCards().length;
        if (!n) return;
        rlActive = ((k % n) + n) % n;
        rlLayout();
        rlBgUpdate();
    }

    function startRoulette() {
        clearInterval(rlTimer);
        rlTimer = setInterval(function () {
            if (!rlHover && current && COL[current].layout === "roulette" && !document.body.classList.contains("modal-open")) rlGo(rlActive + 1);
        }, 4200);
    }

    function stopRoulette() { clearInterval(rlTimer); rlTimer = null; }

    // ---------- escaparate (Cervezas) ----------
    let spActive = 0, spTimer = null;

    function spSlides() { return document.querySelectorAll("#cpGrid .spot-slide"); }

    function makeBubbles(el, n) {
        if (!el) return;
        let h = "";
        for (let i = 0; i < n; i++) {
            const sz = 6 + Math.random() * 20, d = 6 + Math.random() * 8;
            h += '<i style="--x:' + (Math.random() * 100).toFixed(1) + '%;--s:' + sz.toFixed(0) + 'px;--d:' + d.toFixed(1) + 's;--dl:-' + (Math.random() * d).toFixed(1) + 's;--dx:' + ((Math.random() * 60) - 30).toFixed(0) + 'px"></i>';
        }
        el.innerHTML = h;
    }

    function spBgUpdate() {
        const bg = document.getElementById("spBg");
        const sl = spSlides()[spActive];
        if (!bg || !sl || !current) return;
        const u = src(COL[current].items[+sl.dataset.i]);
        bg.classList.add("swap");
        setTimeout(function () {
            bg.style.backgroundImage = u ? 'url("' + u + '")' : "none";
            bg.classList.remove("swap");
        }, 350);
    }

    function spGo(k) {
        const sl = spSlides();
        const n = sl.length;
        if (!n) return;
        spActive = ((k % n) + n) % n;
        sl.forEach(function (el, i) {
            el.classList.toggle("active", i === spActive);
            el.classList.toggle("prev", i < spActive);
        });
        document.querySelectorAll("#cpGrid .sp-thumb").forEach(function (t, i) { t.classList.toggle("active", i === spActive); });
        spBgUpdate();
    }

    function startSpot() {
        clearInterval(spTimer);
        spTimer = setInterval(function () {
            if (!rlHover && current && COL[current].layout === "spot" && !document.body.classList.contains("modal-open")) spGo(spActive + 1);
        }, 5200);
    }

    function stopSpot() { clearInterval(spTimer); spTimer = null; }

    function step(dir) {
        if (!current) return;
        if (COL[current].layout === "roulette") rlGo(rlActive + dir);
        else if (COL[current].layout === "spot") spGo(spActive + dir);
        else if (COL[current].layout === "orbit") obGo(obActive + dir);
        else if (COL[current].layout === "curve") cvGo(cvActive + dir);
        else if (COL[current].layout === "stack") stGo(stActive + dir);
    }

    // ---------- ruleta circular (Licores y cremas) ----------
    let obActive = 0, obTimer = null;

    function obItems() { return document.querySelectorAll("#cpGrid .ob-item"); }
    function obImg(w, i) { return src(w) || FB[i % FB.length]; }
    function pad2(n) { return (n < 10 ? "0" : "") + n; }

    function obLayout() {
        const grid = document.getElementById("cpGrid");
        const items = obItems();
        const n = items.length;
        if (!grid || !n) return;
        const mobile = grid.clientWidth < 768;
        const R = mobile ? Math.min(300, grid.clientWidth * 0.72) : 390;
        const STEP = 29;
        const lim = n > 6 ? 3 : 2;
        items.forEach(function (el, i) {
            let d = i - obActive;
            if (d > n / 2) d -= n;
            if (d < -n / 2) d += n;
            const a = Math.abs(d), phi = d * STEP;
            const sc = a === 0 ? 1 : Math.max(0.28, 0.62 - (a - 1) * 0.14);
            el.style.transform = "rotate(" + phi + "deg) " + (mobile ? "translateY(" + (-R) + "px)" : "translateX(" + (-R) + "px)") + " rotate(" + (-phi) + "deg) scale(" + sc + ")";
            el.style.opacity = a === 0 ? "1" : (a <= lim ? String(Math.max(0.25, 0.9 - (a - 1) * 0.3)) : "0");
            el.style.zIndex = String(50 - a);
            el.style.pointerEvents = a <= lim ? "auto" : "none";
            el.classList.toggle("active", a === 0);
        });
    }

    let obFlip = false;

    function obBgUpdate() {
        const el = obItems()[obActive];
        const layers = document.querySelectorAll("#cpGrid .ob-bg");
        if (!el || layers.length < 2 || !current) return;
        const i = +el.dataset.i;
        obFlip = !obFlip;
        const on = layers[obFlip ? 1 : 0], off = layers[obFlip ? 0 : 1];
        on.style.setProperty("--img", 'url("' + obImg(COL[current].items[i], i) + '")');
        on.classList.add("on");
        off.classList.remove("on");
    }

    function obTextUpdate() {
        const el = obItems()[obActive];
        const box = document.getElementById("obText");
        if (!el || !box || !current) return;
        const i = +el.dataset.i, w = COL[current].items[i];
        box.innerHTML = '<span class="p-badge">' + w.t + '</span><h3>' + w.n + '</h3>' +
                        '<div class="p-price' + (w.p == null ? ' ask' : '') + '">' + money(w.p) + '</div>' +
                        '<p>' + (w.d || "") + '</p>' +
                        '<div class="ob-actions"><button type="button" class="btn-gold" data-add="' + i + '">' + (w.p == null ? "Consultar" : "Agregar") + '</button><button type="button" class="btn-outline-gold ob-open" data-i="' + i + '">Ver información</button></div>';
        const cnt = document.getElementById("obCount");
        if (cnt) cnt.textContent = pad2(obActive + 1) + " / " + pad2(obItems().length);
    }

    function obGo(k) {
        const n = obItems().length;
        if (!n) return;
        obActive = ((k % n) + n) % n;
        obLayout();
        obBgUpdate();
        obTextUpdate();
    }

    function startOrbit() {
        clearInterval(obTimer);
        obTimer = setInterval(function () {
            if (!rlHover && current && COL[current].layout === "orbit" && !document.body.classList.contains("modal-open")) obGo(obActive + 1);
        }, 5200);
    }

    function stopOrbit() { clearInterval(obTimer); obTimer = null; }

    // ---------- carrusel curvo (Especiales) ----------
    let cvActive = 0, cvTimer = null;

    function cvCards() { return document.querySelectorAll("#cpGrid .cv-card"); }

    function cvLayout() {
        const grid = document.getElementById("cpGrid"), cards = cvCards(), n = cards.length;
        if (!grid || !n) return;
        const gap = Math.max(64, Math.min(190, grid.clientWidth * 0.17));
        cards.forEach(function (el, i) {
            let d = i - cvActive;
            if (d > n / 2) d -= n;
            if (d < -n / 2) d += n;
            const a = Math.abs(d);
            el.style.transform = "translateX(" + (d * gap) + "px) translateZ(" + (a * 55) + "px) rotateY(" + (-d * 30) + "deg) scale(" + (a === 0 ? 1.1 : 1) + ")";
            el.style.zIndex = String(20 - a);
            el.style.opacity = a <= 2 ? "1" : (a === 3 ? "0.55" : "0");
            el.style.pointerEvents = a <= 3 ? "auto" : "none";
            el.classList.toggle("active", a === 0);
        });
    }

    function cvInfo() {
        const el = cvCards()[cvActive], box = document.getElementById("cvInfo");
        if (!el || !box || !current) return;
        const i = +el.dataset.i, w = COL[current].items[i];
        box.innerHTML = '<span class="p-badge">' + w.t + '</span><h3>' + w.n + '</h3>' +
            '<div class="p-price' + (w.p == null ? ' ask' : '') + '">' + money(w.p) + '</div><p>' + (w.d || "") + '</p>' +
            '<div class="cv-actions"><button type="button" class="btn-gold" data-add="' + i + '">' + (w.p == null ? "Consultar" : "Agregar al carrito") + '</button>' +
            '<button type="button" class="btn-outline-gold cv-open" data-i="' + i + '">Ver información</button></div>';
    }

    function cvGo(k) {
        const n = cvCards().length;
        if (!n) return;
        cvActive = ((k % n) + n) % n;
        cvLayout();
        cvInfo();
    }

    function startCurve() {
        clearInterval(cvTimer);
        cvTimer = setInterval(function () {
            if (!rlHover && current && COL[current].layout === "curve" && !document.body.classList.contains("modal-open")) cvGo(cvActive + 1);
        }, 2400);
    }

    function stopCurve() { clearInterval(cvTimer); cvTimer = null; }

    // ---------- baraja de cartas (Licores) ----------
    let stActive = 0, stTimer = null;

    function stCards() { return document.querySelectorAll("#cpGrid .st-card"); }

    function stLayout() {
        const cards = stCards(), n = cards.length;
        if (!n) return;
        cards.forEach(function (el, i) {
            const d = (i - stActive + n) % n;
            el.style.transform = "translate(" + (d * 36) + "px," + (d * -16) + "px) scale(" + (1 - d * 0.06) + ") rotate(" + (d * 3) + "deg)";
            el.style.zIndex = String(50 - d);
            el.style.opacity = d <= 3 ? String(1 - d * 0.18) : "0";
            el.style.pointerEvents = d === 0 ? "auto" : "none";
            el.classList.toggle("active", d === 0);
        });
    }

    function stInfo() {
        const el = stCards()[stActive], box = document.getElementById("stInfo");
        if (!el || !box || !current) return;
        const i = +el.dataset.i, w = COL[current].items[i];
        box.innerHTML = '<span class="p-badge">' + w.t + '</span><h3>' + w.n + '</h3>' +
            '<div class="p-price' + (w.p == null ? ' ask' : '') + '">' + money(w.p) + '</div><p>' + (w.d || "") + '</p>' +
            '<div class="ob-actions"><button type="button" class="btn-gold" data-add="' + i + '">' + (w.p == null ? "Consultar" : "Agregar") + '</button>' +
            '<button type="button" class="btn-outline-gold st-open" data-i="' + i + '">Ver información</button></div>';
        const cnt = document.getElementById("stCount");
        if (cnt) cnt.textContent = pad2(stActive + 1) + " / " + pad2(stCards().length);
    }

    function stBg() {
        const el = stCards()[stActive], bg = document.getElementById("stBg");
        if (!el || !bg || !current) return;
        const u = src(COL[current].items[+el.dataset.i]);
        bg.classList.add("swap");
        setTimeout(function () { bg.style.setProperty("--img", u ? 'url("' + u + '")' : "none"); bg.classList.remove("swap"); }, 300);
    }

    function stGo(k) {
        const cards = stCards(), n = cards.length;
        if (!n) return;
        const nxt = ((k % n) + n) % n;
        if (nxt === stActive) return;
        const old = cards[stActive];
        stActive = nxt;
        if (old) {
            old.classList.add("fly");
            setTimeout(function () {
                old.style.transition = "none";
                old.classList.remove("fly");
                void old.offsetWidth;
                old.style.transition = "";
            }, 580);
        }
        stLayout();
        stInfo();
        stBg();
    }

    function startStack() {
        clearInterval(stTimer);
        stTimer = setInterval(function () {
            if (!rlHover && current && COL[current].layout === "stack" && !document.body.classList.contains("modal-open")) stGo(stActive + 1);
        }, 3800);
    }

    function stopStack() { clearInterval(stTimer); stTimer = null; }

    function fillGrid(first) {
        const c = COL[current];
        const grid = document.getElementById("cpGrid");
        grid.style.setProperty("--base", first ? "1s" : "0s");
        const list = c.items.map(function (w, i) { return {w: w, i: i}; })
                            .filter(function (o) { return filter === "todos" || o.w.g === filter; });

        if (c.layout === "curve") {
            const cards = list.map(function (o, k) {
                return '<button type="button" class="cv-card" data-i="' + o.i + '" data-k="' + k + '" style="--i:' + k + '" aria-label="' + o.w.n + '">' +
                       '<span class="cv-label"><b>' + o.w.n + '</b><span>' + money(o.w.p) + '</span></span></button>';
            }).join("");
            grid.innerHTML = '<div class="cv-bg"></div><div class="cv-shade"></div><div class="cv-stage">' + cards + '</div>' +
                '<div class="cv-nav"><button type="button" class="cv-btn prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>' +
                '<button type="button" class="cv-btn next" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button></div>' +
                '<div class="cv-info" id="cvInfo"></div>';
            grid.querySelector(".cv-bg").style.backgroundImage = 'url("' + c.bg + '")';
            cvCards().forEach(function (el) {
                const u = src(c.items[+el.dataset.i]);
                if (u) el.style.backgroundImage = 'url("' + u + '")';
                if (first) { el.style.transform = "scale(.2) rotateY(180deg)"; el.style.opacity = "0"; }
            });
            cvActive = 0;
            grid.classList.toggle("cv-intro", !!first);
            requestAnimationFrame(function () { requestAnimationFrame(function () { cvGo(0); }); });
            setTimeout(function () { grid.classList.remove("cv-intro"); startCurve(); }, first ? 3200 : 1500);
            return;
        }

        if (c.layout === "stack") {
            const cards = list.map(function (o, k) {
                return '<button type="button" class="st-card" data-i="' + o.i + '" data-k="' + k + '" style="--i:' + k + '" aria-label="' + o.w.n + '">' +
                       '<span class="cv-label"><b>' + o.w.n + '</b><span>' + money(o.w.p) + '</span></span></button>';
            }).join("");
            grid.innerHTML = '<div class="st-bg" id="stBg"></div><div class="st-info" id="stInfo"></div><div class="st-deck">' + cards + '</div>' +
                '<div class="st-count" id="stCount"></div>' +
                '<div class="st-nav"><button type="button" class="st-btn prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>' +
                '<button type="button" class="st-btn next" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button></div>';
            stCards().forEach(function (el) {
                const u = src(c.items[+el.dataset.i]);
                el.style.setProperty("--img", u ? 'url("' + u + '")' : "none");
                if (first) { el.style.transform = "translateY(-540px) rotate(-14deg)"; el.style.opacity = "0"; }
            });
            stActive = 0;
            grid.classList.toggle("st-intro", !!first);
            requestAnimationFrame(function () { requestAnimationFrame(function () { stLayout(); stInfo(); stBg(); }); });
            setTimeout(function () { grid.classList.remove("st-intro"); startStack(); }, first ? 3800 : 2000);
            return;
        }

        if (c.layout === "orbit") {
            const wheel = list.map(function (o, k) {
                return '<button type="button" class="ob-item" data-i="' + o.i + '" data-k="' + k + '" aria-label="' + o.w.n + '"></button>';
            }).join("");
            grid.innerHTML = '<div class="ob-bg"></div><div class="ob-bg"></div><div class="ob-shade"></div>' +
                '<div class="ob-text" id="obText"></div>' +
                '<div class="ob-wheel' + (first ? "" : " no-intro") + '">' + wheel + '</div>' +
                '<div class="ob-count" id="obCount"></div>' +
                '<div class="ob-nav"><button type="button" class="ob-btn prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>' +
                '<button type="button" class="ob-btn next" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button></div>';
            obItems().forEach(function (el) {
                const i = +el.dataset.i;
                el.style.backgroundImage = 'url("' + obImg(c.items[i], i) + '")';
                if (first) { el.style.transform = "scale(0)"; el.style.opacity = "0"; }
            });
            obActive = 0;
            if (first) {
                requestAnimationFrame(function () { requestAnimationFrame(function () { obGo(0); }); });
            } else {
                obGo(0);
            }
            setTimeout(startOrbit, first ? 5500 : 2500);
            return;
        }

        if (c.layout === "spot") {
            const slides = list.map(function (o, k) {
                return '<div class="spot-slide" data-i="' + o.i + '" data-k="' + k + '">' +
                       '<div class="spot-text"><span class="p-badge sp-badge">' + o.w.t + '</span>' +
                       '<h3>' + o.w.n + '</h3>' +
                       '<div class="p-price' + (o.w.p == null ? ' ask' : '') + '">' + money(o.w.p) + '</div>' +
                       '<p>' + (o.w.d || "") + '</p>' +
                       '<div class="ob-actions"><button type="button" class="btn-gold" data-add="' + o.i + '">' + (o.w.p == null ? "Consultar" : "Agregar") + '</button><button type="button" class="btn-outline-gold sp-open">Ver información</button></div></div>' +
                       '<div class="spot-img">' + media(o.w, c.icon) + '</div></div>';
            }).join("");
            const thumbs = list.map(function (o, k) {
                return '<button type="button" class="sp-thumb" data-k="' + k + '" aria-label="' + o.w.n + '">' + media(o.w, c.icon) + '</button>';
            }).join("");
            grid.innerHTML = '<div class="spot-bg" id="spBg"></div><div class="bubbles"></div>' + slides +
                '<button type="button" class="p-arrow prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>' +
                '<button type="button" class="p-arrow next" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button>' +
                '<div class="spot-thumbs">' + thumbs + '</div>';
            makeBubbles(grid.querySelector(".bubbles"), 24);
            spGo(0);
            setTimeout(startSpot, 6500);
            return;
        }

        grid.innerHTML = list.map(function (o, k) { return cardHTML(o.w, o.i, k, current, c.icon, c.layout); }).join("");

        if (c.layout === "roulette") {
            rlActive = 0;
            grid.classList.add("rl-intro");
            rlCards().forEach(function (el) { el.style.transform = "scale(.2) rotateY(540deg)"; el.style.opacity = "0"; });
            requestAnimationFrame(function () { requestAnimationFrame(function () { rlLayout(); rlBgUpdate(); }); });
            setTimeout(function () { grid.classList.remove("rl-intro"); startRoulette(); }, 3600);
        } else {
            grid.scrollTo({left: 0, behavior: "auto"});
        }
    }

    function pageHTML(key) {
        const c = COL[key];
        const chips = c.filters.map(function (f, k) {
            return '<button type="button" class="p-chip' + (k === 0 ? ' active' : '') + '" data-f="' + f[0] + '">' + f[1] + '</button>';
        }).join("");
        const info = c.info.map(function (t, k) {
            return '<div class="col-md-4"><div class="info-tile" style="--k:' + k + '"><i class="fa-solid ' + t.i + '"></i><h5>' + t.t + '</h5><p>' + t.x + '</p></div></div>';
        }).join("");
        const others = KEYS.filter(function (k) { return k !== key; }).map(function (k) {
            return '<a href="#' + k + '" class="other-link"><i class="fa-solid ' + COL[k].icon + '"></i><span>' + COL[k].title + '</span><small>' + COL[k].kicker + '</small></a>';
        }).join("");
        const arrows = (c.layout === "carousel" || c.layout === "roulette")
            ? '<button type="button" class="p-arrow prev" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></button>' +
              '<button type="button" class="p-arrow next" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></button>'
            : "";
        return '<div class="col-hero">' + (key === "cervezas" ? '<div class="bubbles"></div><div class="foam"></div>' : "") + '<div class="container">' +
                   '<button type="button" class="col-back" data-back><i class="fa-solid fa-arrow-left me-2"></i>Volver al inicio</button>' +
                   '<div class="section-label mt-4">' + c.kicker + '</div>' +
                   '<h1 class="col-title">' + c.title + '</h1>' +
                   '<p class="col-tag">' + c.tag + '</p>' +
                   '<p class="col-desc">' + c.desc + '</p>' +
                   '<span class="col-count"><i class="fa-solid ' + c.icon + '"></i>' + c.items.length + ' productos</span>' +
               '</div></div>' +
               '<div class="container col-body">' +
                   '<div class="row g-4">' + info + '</div>' +
                   '<div class="col-products">' +
                       '<div class="text-center"><div class="section-label">Nuestra selección</div><h2 class="types-title mt-2">' + c.title + '</h2></div>' +
                       (c.filters.length > 1 ? '<div class="p-chips">' + chips + '</div>' : '<div class="mb-4"></div>') +
                       '<div class="col-stage' + (c.layout === "roulette" ? " rl" : "") + '">' + (c.layout === "roulette" ? '<div class="rl-bg" id="rlBg"></div>' : "") + arrows + '<div class="col-grid layout-' + c.layout + '" id="cpGrid"></div></div>' +
                   '</div>' +
                   '<div class="col-others">' + others + '</div>' +
               '</div>';
    }

    function beerIntro() {
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const old = document.getElementById("beerIntro");
        if (old) old.remove();
        const el = document.createElement("div");
        el.className = "beer-intro";
        el.id = "beerIntro";
        el.innerHTML = '<div class="bi-liquid">' +
            '<svg class="bi-wave" viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0 34 Q 37 4 75 34 T 150 34 T 225 34 T 300 34 T 375 34 T 450 34 T 525 34 T 600 34 T 675 34 T 750 34 T 825 34 T 900 34 T 975 34 T 1050 34 T 1125 34 T 1200 34 V60 H0 Z" fill="#fff6dc"/></svg>' +
            '</div>' +
            '<div class="bi-mugs"><i class="fa-solid fa-beer-mug-empty bi-l"></i><i class="fa-solid fa-beer-mug-empty bi-r"></i><span class="bi-spark"></span></div>' +
            '<div class="bi-text">¡Salud!</div>';
        document.body.appendChild(el);
        setTimeout(function () { el.remove(); }, 3200);
    }

    function openPage(key) {
        stopRoulette();
        stopSpot();
        stopOrbit();
        stopCurve();
        stopStack();
        current = key;
        filter = "todos";
        homeEls.forEach(function (el) { el.hidden = true; });
        page.className = "col-page t-" + key;
        page.innerHTML = pageHTML(key);
        page.querySelector(".col-hero").style.setProperty("--bgimg", 'url("' + COL[key].bg + '")');
        page.hidden = false;
        if (key === "cervezas") beerIntro();
        page.querySelectorAll(".col-hero .bubbles").forEach(function (b) { makeBubbles(b, 26); });
        fillGrid(true);
        window.scrollTo({top: 0, behavior: "auto"});
        document.title = COL[key].title + " | Libido y Tentación";
    }

    function closePage() {
        stopRoulette();
        stopSpot();
        stopOrbit();
        stopCurve();
        stopStack();
        page.hidden = true;
        page.innerHTML = "";
        current = null;
        homeEls.forEach(function (el) { el.hidden = false; });
        document.title = "Libido y Tentación | licorería";
    }

    function openDetail(i) {
        const c = COL[current], w = c.items[i];
        modalEl.className = "modal fade dm-" + current;
        document.body.dataset.dm = current;
        dmItem = {key: current, i: i, qty: 1};
        dmRefresh();
        document.getElementById("dmImg").innerHTML = media(w, c.icon);
        document.getElementById("dmType").textContent = w.t;
        document.getElementById("dmName").textContent = w.n;
        const price = document.getElementById("dmPrice");
        price.textContent = money(w.p);
        price.className = "p-price" + (w.p == null ? " ask" : "");
        document.getElementById("dmDesc").textContent = w.d || "";
        document.getElementById("dmFacts").innerHTML = [["Origen", w.pais], ["Cepa", w.cepa], ["Formato", w.fmt], ["Alcohol", w.alc]]
            .filter(function (f) { return f[1]; })
            .map(function (f) { return "<li><span>" + f[0] + "</span><b>" + f[1] + "</b></li>"; }).join("");
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    modalEl.addEventListener("hidden.bs.modal", function () { delete document.body.dataset.dm; });

    page.addEventListener("click", function (e) {
        if (Date.now() < rlIgnoreUntil) return;
        if (e.target.closest("[data-back]")) { location.hash = "colecciones"; return; }

        const addBtn = e.target.closest("[data-add]");
        if (addBtn) { addToCart(current, +addBtn.dataset.add, 1, addBtn); return; }

        const cvCard = e.target.closest(".cv-card");
        if (cvCard) { if (cvCard.classList.contains("active")) openDetail(+cvCard.dataset.i); else cvGo(+cvCard.dataset.k); return; }
        const cvOpen = e.target.closest(".cv-open");
        if (cvOpen) { openDetail(+cvOpen.dataset.i); return; }
        const cvBtn = e.target.closest(".cv-btn");
        if (cvBtn) { cvGo(cvActive + (cvBtn.classList.contains("prev") ? -1 : 1)); return; }

        const stCard = e.target.closest(".st-card");
        if (stCard) { if (stCard.classList.contains("active")) openDetail(+stCard.dataset.i); else stGo(+stCard.dataset.k); return; }
        const stOpen = e.target.closest(".st-open");
        if (stOpen) { openDetail(+stOpen.dataset.i); return; }
        const stBtn = e.target.closest(".st-btn");
        if (stBtn) { stGo(stActive + (stBtn.classList.contains("prev") ? -1 : 1)); return; }

        const chip = e.target.closest(".p-chip");
        if (chip) {
            page.querySelectorAll(".p-chip").forEach(function (c) { c.classList.toggle("active", c === chip); });
            filter = chip.dataset.f;
            fillGrid(false);
            return;
        }

        const arrow = e.target.closest(".p-arrow");
        if (arrow) {
            const dir = arrow.classList.contains("prev") ? -1 : 1;
            if (COL[current].layout === "roulette" || COL[current].layout === "spot") { step(dir); return; }
            const g = document.getElementById("cpGrid");
            g.scrollBy({left: dir * g.clientWidth * 0.8});
            return;
        }

        const obItem = e.target.closest(".ob-item");
        if (obItem) {
            if (obItem.classList.contains("active")) openDetail(+obItem.dataset.i);
            else obGo(+obItem.dataset.k);
            return;
        }

        const obOpen = e.target.closest(".ob-open");
        if (obOpen) { openDetail(+obOpen.dataset.i); return; }

        const obBtn = e.target.closest(".ob-btn");
        if (obBtn) { obGo(obActive + (obBtn.classList.contains("prev") ? -1 : 1)); return; }

        const spOpen = e.target.closest(".sp-open, .spot-img");
        if (spOpen) { openDetail(+spOpen.closest(".spot-slide").dataset.i); return; }

        const thumb = e.target.closest(".sp-thumb");
        if (thumb) { spGo(+thumb.dataset.k); return; }

        const card = e.target.closest(".p-card");
        if (card) {
            if (card.classList.contains("rl-card") && !card.classList.contains("active")) { rlGo(+card.dataset.k); return; }
            openDetail(+card.dataset.i);
        }
    });

    // ruleta: pausa al pasar el mouse, deslizar con el dedo y teclado
    page.addEventListener("mouseover", function (e) { if (e.target.closest(".rl, .layout-spot, .layout-orbit, .layout-curve, .layout-stack")) rlHover = true; });
    page.addEventListener("mouseout", function (e) {
        if (e.target.closest(".rl, .layout-spot, .layout-orbit, .layout-curve, .layout-stack") && !(e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest(".rl, .layout-spot, .layout-orbit, .layout-curve, .layout-stack"))) rlHover = false;
    });
    page.addEventListener("pointerdown", function (e) { if (e.target.closest(".layout-roulette, .layout-spot, .layout-orbit, .layout-curve, .layout-stack")) swipeX = e.clientX; });
    page.addEventListener("pointerup", function (e) {
        if (swipeX === null) return;
        const dx = e.clientX - swipeX;
        swipeX = null;
        if (Math.abs(dx) > 45) { rlIgnoreUntil = Date.now() + 350; step(dx < 0 ? 1 : -1); }
    });
    document.addEventListener("keydown", function (e) {
        if (!current || (["roulette", "spot", "orbit", "curve", "stack"].indexOf(COL[current].layout) === -1) || document.body.classList.contains("modal-open")) return;
        if (e.key === "ArrowRight") step(1);
        if (e.key === "ArrowLeft") step(-1);
    });

    // navegación: #vinos, #licores, #especiales abren su página; cualquier otro vuelve al inicio
    function route() {
        const id = decodeURIComponent(location.hash.slice(1));
        if (KEYS.indexOf(id) > -1) { openPage(id); return; }
        const wasOpen = !page.hidden;
        closePage();
        const target = id ? document.getElementById(id) : (wasOpen ? document.getElementById("colecciones") : null);
        if (target) setTimeout(function () { target.scrollIntoView({behavior: wasOpen ? "auto" : "smooth"}); }, 60);
    }

    function safeRoute() {
        try { route(); }
        catch (err) {
            console.error(err);
            if (["127.0.0.1", "localhost"].indexOf(location.hostname) > -1) {
                let b = document.getElementById("devError");
                if (!b) { b = document.createElement("div"); b.id = "devError"; b.style.cssText = "position:fixed;left:12px;bottom:12px;z-index:99999;max-width:min(92vw,520px);background:#7a0f1f;color:#fff;padding:12px 16px;border-radius:6px;font:13px/1.5 monospace"; document.body.appendChild(b); }
                b.textContent = "Error al abrir la sección: " + (err && err.message ? err.message : err);
            }
        }
    }

    // ---------- PUBLICIDAD: carrusel curvo ----------
    const adStage = document.getElementById("adStage");
    let adActive = 0, adTimer = null, adHover = false, adSwipe = null, adIgnore = 0;

    function adCards() { return adStage ? adStage.querySelectorAll(".ad-c") : []; }

    function adLayout() {
        const cards = adCards(), n = cards.length;
        if (!n) return;
        const gap = Math.max(60, Math.min(215, adStage.clientWidth * 0.17));
        cards.forEach(function (el, i) {
            let d = i - adActive;
            if (d > n / 2) d -= n;
            if (d < -n / 2) d += n;
            const a = Math.abs(d);
            el.style.transform = "translateX(" + (d * gap) + "px) translateZ(" + (a * 50) + "px) rotateY(" + (-d * 30) + "deg) scale(" + (a === 0 ? 1.08 : 1) + ")";
            el.style.zIndex = String(20 - a);
            el.style.opacity = a <= 2 ? "1" : (a === 3 ? "0.5" : "0");
            el.style.pointerEvents = a <= 3 ? "auto" : "none";
            el.classList.toggle("active", a === 0);
        });
    }

    function adGo(k) {
        const n = adCards().length;
        if (!n) return;
        adActive = ((k % n) + n) % n;
        adLayout();
    }

    function openAd(k) {
        const a = ANUNCIOS[k], m = document.getElementById("adModal");
        m.className = "modal fade am-modal";
        document.getElementById("amImg").innerHTML = '<div class="am-blur" style="--img:url(\'' + a.img + '\')"></div><img src="' + a.img + '" alt="' + a.t + '" referrerpolicy="no-referrer" data-px>';
        document.getElementById("amKicker").textContent = a.s;
        document.getElementById("amTitle").textContent = a.t;
        document.getElementById("amDesc").textContent = a.d || "";
        document.getElementById("amFacts").innerHTML = [["Atención", "Tienda y seguimiento del pedido"], ["Entrega", "Delivery y recojo"], ["Pagos", "Yape · Plin · Débito"]]
            .map(function (f) { return "<li><span>" + f[0] + "</span><b>" + f[1] + "</b></li>"; }).join("");
        const go = document.getElementById("amGo");
        go.textContent = a.go && COL[a.go] ? "Ver " + COL[a.go].title : "Ver colecciones";
        go.dataset.go = a.go || "colecciones";
        bootstrap.Modal.getOrCreateInstance(m).show();
    }

    if (adStage) {
        adStage.innerHTML = ANUNCIOS.map(function (a, k) {
            return '<button type="button" class="ad-c" data-k="' + k + '" aria-label="' + a.t + '"><img src="' + a.img + '" alt="" data-px referrerpolicy="no-referrer">' +
                   '<span class="ad-l"><small>' + a.s + '</small><b>' + a.t + '</b></span></button>';
        }).join("");
        adLayout();
        window.addEventListener("resize", adLayout);
        adStage.addEventListener("click", function (e) {
            if (Date.now() < adIgnore) return;
            const c = e.target.closest(".ad-c");
            if (!c) return;
            if (c.classList.contains("active")) openAd(+c.dataset.k); else adGo(+c.dataset.k);
        });
        document.getElementById("adPrev").addEventListener("click", function () { adGo(adActive - 1); });
        document.getElementById("adNext").addEventListener("click", function () { adGo(adActive + 1); });
        const wrap = adStage.parentElement;
        wrap.addEventListener("mouseenter", function () { adHover = true; });
        wrap.addEventListener("mouseleave", function () { adHover = false; });
        adStage.addEventListener("pointerdown", function (e) { adSwipe = e.clientX; });
        adStage.addEventListener("pointerup", function (e) {
            if (adSwipe === null) return;
            const dx = e.clientX - adSwipe;
            adSwipe = null;
            if (Math.abs(dx) > 45) { adIgnore = Date.now() + 350; adGo(adActive + (dx < 0 ? 1 : -1)); }
        });
        adTimer = setInterval(function () {
            if (!adHover && adStage.offsetParent !== null && !document.body.classList.contains("modal-open")) adGo(adActive + 1);
        }, 2300);
        document.getElementById("amGo").addEventListener("click", function () {
            const inst = bootstrap.Modal.getInstance(document.getElementById("adModal"));
            if (inst) inst.hide();
            location.hash = this.dataset.go || "colecciones";
        });
    }

    window.addEventListener("hashchange", safeRoute);
    safeRoute();
})();
</script>

</body>
</html>